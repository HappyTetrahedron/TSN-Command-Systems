{% import 'Toggle.xml' as toggle %}
{% import 'Utils.xml' as util %}

{% macro _drawButtonGrid(buttons, x, y, w, h, rows, padding=2) %}
  {% for buttondata in buttons %}
    {% if buttondata.type == "standard" %}
      <set_gm_button text="{{ buttondata.name }}" x="{{ x + (loop.index0 / rows)|int * w }}" y="{{ y + (loop.index0 % rows) * h }}" w="{{ w - padding }}" h="{{ h - padding }}" />
    {% elif buttondata.type == "toggle" %}
      <set_variable name="Toggle_{{ buttondata.name | stripspace }}_ShouldShow" value="1" integer="yes" />
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro _clearButtonGrid(buttons) %}
  {% for buttondata in buttons %}
    {% if buttondata.type == "standard" %}
      <clear_gm_button text="{{ buttondata.name }}" />
    {% elif buttondata.type == "toggle" %}
      <set_variable name="Toggle_{{ buttondata.name | stripspace }}_ShouldShow" value="0" integer="yes" />
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro _buttonHandlersNonStandard(name, x, y, w, h, rows, padding=2) %}
  {% for buttondata in retrieve("specialbuttons" + name) %}
    {% if buttondata.type == "toggle" %}
      {{ toggle.Toggle(buttondata.name, buttondata.variable, buttondata.valueMap, buttondata.x, buttondata.y, buttondata.w, buttondata.h) }}
    {% endif %}
  {% endfor %}
  {% for buttondata in retrieve("buttons" + name) %}
    {% if buttondata.type == "toggle" %}
      {{ toggle.Toggle(buttondata.name, buttondata.variable, buttondata.valueMap, x + (loop.index0 / rows)|int * w, y + (loop.index0 % rows) * h, w - 2, h - 2) }}
    {% endif %}
  {% endfor %}
{% endmacro %}


{% macro renderMenuBodyCommon(name) %}
    {% for specbut in retrieve("specialbuttons" + name) %}
      <set_gm_button text="{{ specbut.name }}" x="{{ specbut.x }}" y="{{ specbut.y }}" w="{{ specbut.w }}" h="{{ specbut.h }}" /> 
    {% endfor %}
    {% for permmenu in retrieve("permSubmenus" + name) %}
      <set_variable name="GM_Submenu_{{ permmenu | stripspace }}_ShouldShow" value="1.0" integer="yes" />
    {% endfor %}
    {% for buttonsubmenu in retrieve("buttonSubs" + name) %}
      {{ util.restore("GM_Submenu_" + buttonsubmenu | stripspace + "_ShouldShow") }}
    {% endfor %}
    {% for mutexsubmenu in retrieve("mutexSubmenus" + name) %}
      {{ util.restore("GM_" + mutexsubmenu | stripspace + "_Selector") }}
    {% endfor %}
    {% for caller in retrieve("extrastatements" + name) %}
      {{ caller(True) }}
    {% endfor %}
    {% for var in retrieve("extravars" + name) %}
      {% if var[2] == "restore" %}
        {{ util.storeAndSet(var[0], var[1]) }}
      {% else %}
        <set_variable name="{{ var[0] }}" value="{{ var[1] }}.0" integer="yes" />
      {% endif %}
    {% endfor %}
{% endmacro %}

{% macro cleanupMenuBodyCommon(name) %}
    {{ _clearButtonGrid(retrieve("buttons" + name)) }}
    {% for specbut in retrieve("specialbuttons" + name) %}
      <clear_gm_button text="{{ specbut.name }}" /> 
    {% endfor %}
    {% for permmenu in retrieve("permSubmenus" + name) %}
      <set_variable name="GM_Submenu_{{ permmenu | stripspace }}_ShouldShow" value="0.0" integer="yes" />
    {% endfor %}
    {% for buttonsubmenu in retrieve("buttonSubs" + name) %}
      {{ util.storeAndSet("GM_Submenu_" + buttonsubmenu | stripspace + "_ShouldShow") }}
    {% endfor %}
    {% for mutexsubmenu in retrieve("mutexSubmenus" + name) %}
      {{ util.storeAndSet("GM_" + mutexsubmenu | stripspace + "_Selector") }}
    {% endfor %}
    {% for caller in retrieve("extrastatements" + name) %}
      {{ caller(False) }}
    {% endfor %}
    {% for var in retrieve("extravars" + name) %}
      {% if var[2] == "restore" %}
        {{ util.restore(var[0]) }}
      {% elif var[2] %}
        <set_variable name="{{ var[0] }}" value="{{ var[2] }}.0" integer="yes" />
      {% endif %}
    {% endfor %}
{% endmacro %}

{% macro renderButtonMenu(menu) %}
    {% if menu.body %}
      {{ menu.body(True) }}
    {% endif %}
    {{ _drawButtonGrid(retrieve("buttons" + menu.name), menu.buttons.x, menu.buttons.y, menu.buttons.w, menu.buttons.h, menu.buttons.rows) }}
    {{ renderMenuBodyCommon(menu.name) }}
{% endmacro %}

{% macro cleanupButtonMenu(menu) %}
    {% if menu.body %}
      {{ menu.body(False) }}
    {% endif %}
    {{ _clearButtonGrid(retrieve("buttons" + menu.name)) }}
    {{ cleanupMenuBodyCommon(menu.name) }}
{% endmacro %}

{% macro renderExpandMenu(menu) %}
    {% for button in retrieve("menukey" + menu.name) %}
      <set_gm_button text="{{ menu.name }}\{{ button }}" />
    {% endfor %}
    {% for button in retrieve("menukeyRaw" + menu.name) %}
      <set_gm_button text="{{ button }}" />
    {% endfor %}
    {% if menu.type == "dismissableSubmenu" %}
      <set_gm_button text="{{ menu.name }}\_Dismiss" />
    {% endif %}
    {{ renderMenuBodyCommon(menu.name) }}
{% endmacro %}

{% macro cleanupExpandMenu(menu) %}
    {% for button in retrieve("menukey" + menu.name) %}
      <clear_gm_button text="{{ menu.name }}\{{ button }}" />
    {% endfor %}
    {% for button in retrieve("menukeyRaw" + menu.name) %}
      <clear_gm_button text="{{ button }}" />
    {% endfor %}
    {% if menu.type == "dismissableSubmenu" %}
      <clear_gm_button text="{{ menu.name }}\_Dismiss" />
    {% endif %}
    {{ cleanupMenuBodyCommon(menu.name) }}
{% endmacro %}

{% macro renderMenu(menu) %}
  {% if menu.type == "buttonExpandMenu" %}
    {{ renderButtonMenu(menu) }}
  {% else %}
    {{ renderExpandMenu(menu) }}
  {% endif %}
{% endmacro %}

{% macro cleanupMenu(menu) %}
  {% if menu.type == "buttonExpandMenu" %}
    {{ cleanupButtonMenu(menu) }}
  {% else %}
    {{ cleanupExpandMenu(menu) }}
  {% endif %}
{% endmacro %}

{% macro independentMenu(menu) %}
  {% set name = menu.name %}
  <event name="SubMenu Create {{ name }}">
    <if_variable name="GM_Submenu_{{ name | stripspace }}_ShouldShow" comparator="EQUALS" value="1.0" />
    <if_variable name="_GM_Submenu_{{ name | stripspace }}_Active" comparator="NOT" value="1.0" />
    {{ caller (True) }}
    <set_variable name="_GM_Submenu_{{ name | stripspace }}_Active" value="1.0" integer="yes" />
  </event>
  <event name="SubMenu Destroy {{ name }}">
    <if_variable name="GM_Submenu_{{ name | stripspace }}_ShouldShow" comparator="NOT" value="1.0" />
    <if_variable name="_GM_Submenu_{{ name | stripspace }}_Active" comparator="EQUALS" value="1.0" />
    {{ caller (False) }}
    <set_variable name="_GM_Submenu_{{ name | stripspace }}_Active" value="0.0" integer="yes" />
  </event>
  {{ _buttonHandlersNonStandard(menu.name, menu.buttons.x, menu.buttons.y, menu.buttons.w, menu.buttons.h, menu.buttons.rows) }}
{% endmacro %}

{% macro mutexMenu(menu, mutexKey, id) %}
  {% set name = menu.name %}
  <event name="Menu Create {{ name }}">
    <if_variable name="GM_{{ mutexKey | stripspace }}_Selector" comparator="EQUALS" value="{{ id }}.0" />
    <if_variable name="_GM_{{ mutexKey | stripspace }}_{{ name | stripspace }}_Active" comparator="NOT" value="1.0" />
    {{ caller(True) }}
    <set_variable name="_GM_{{ mutexKey | stripspace }}_{{ name | stripspace }}_Active" value="1.0" integer="yes" />
  </event>
  <event name="Menu Destroy {{ name }}">
    <if_variable name="GM_{{ mutexKey | stripspace }}_Selector" comparator="NOT" value="{{ id }}.0" />
    <if_variable name="_GM_{{ mutexKey | stripspace }}_{{ name | stripspace }}_Active" comparator="EQUALS" value="1.0" />
    {{ caller(False) }}
    <set_variable name="_GM_{{ mutexKey | stripspace }}_{{ name | stripspace }}_Active" value="0.0" integer="yes" />
  </event>
  {{ _buttonHandlersNonStandard(menu.name, menu.buttons.x, menu.buttons.y, menu.buttons.w, menu.buttons.h, menu.buttons.rows) }}
  {{ selectMutexMenu(name, mutexKey, id, menu.button) }}
{% endmacro %}

{% macro dismissIndependentMenu(name, button) %}
  <event name="SubMenu Dismiss {{ name }} ({{ button }})">
    <if_gm_button text="{{ button }}" />
    {% if caller %}
      {{ caller() }}
    {% endif %}
    <set_variable name="GM_Submenu_{{ name | stripspace }}_ShouldShow" value="0.0" integer="yes" />
  </event>
{% endmacro %}

{% macro activateIndependentMenu(name, button, mutexKey="", guard=0) %}
  <event name="SubMenu Activate {{ name }}">
    <if_gm_button text="{{ button }}" />
    {% if guard > 0 and mutexKey != "" %}
      <if_variable name="GM_{{ mutexKey | stripspace }}_Selector" comparator="EQUALS" value="{{ guard }}.0" />
    {% endif %}
    {% if caller %}
      {{ caller() }}
    {% endif %}
    {% for hcaller in retrieve("extrastatementsBtn" + name) %}
      {{ hcaller() }}
    {% endfor %}
    {% for var in retrieve("extravarsBtn" + name) %}
      <set_variable name="{{ var[0] }}" value="{{ var[1] }}.0" integer="yes" />
    {% endfor %}
    <set_variable name="GM_Submenu_{{ name | stripspace }}_ShouldShow" value="1.0" integer="yes" />
  </event>
{% endmacro %}

{% macro selectMutexMenu(name, mutexKey, id, button) %}
  <event name="Menu Activate {{ name }}">
    <if_gm_button text="{{ button }}" />
    {% for caller in retrieve("extrastatementsBtn" + name) %}
      {{ caller() }}
    {% endfor %}
    {% for var in retrieve("extravarsBtn" + name) %}
      <set_variable name="{{ var[0] }}" value="{{ var[1] }}.0" integer="yes" />
    {% endfor %}
    <set_variable name="GM_{{ mutexKey | stripspace }}_Selector" value="{{ id }}.0" integer="yes" />
  </event>
{% endmacro %}

{% macro generateMenuEvents(menu) %}
  {# Menu draw and cleanup events #}
  {% if menu.selection == "mutex" %}
     {% call(isCreate) mutexMenu(menu, menu.mutexKey, menu.id) %}
        {% if isCreate %} 
         {{ renderMenu(menu) }}
        {% else %}
         {{ cleanupMenu(menu) }}
        {% endif %}
     {% endcall %}
  {% else %}
     {% call(isCreate) independentMenu(menu) %}
        {% if isCreate %} 
         {{ renderMenu(menu) }}
        {% else %}
         {{ cleanupMenu(menu) }}
        {% endif %}
     {% endcall %}
  {% endif %}

  {# Appropriate handlers for opening / closing the menu #}

  {# individual (non-mutex) menus need individual handlers #}
  {% if menu.selection != "mutex" %}
    {% if menu.type == "dismissableSubmenu" %}
      {{ activateIndependentMenu(menu.name, menu.button) }}
      {{ dismissIndependentMenu(menu.name, menu.name + "\\_Dismiss") }}
    {% endif %}

    {% if menu.type == "ephemeralSubmenu" %}
      {{ activateIndependentMenu(menu.name, menu.button) }}
      {% for button in retrieve("menukey" + menu.name) %}
        {{ dismissIndependentMenu(menu.name, menu.name + "\\" + button) }}
      {% endfor %}
      {% for button in retrieve("menukeyRaw" + menu.name) %}
        {{ dismissIndependentMenu(menu.name, button) }}
      {% endfor %}
    {% endif %}

    {% if menu.type == "buttonExpandMenu" %}
      {{ activateIndependentMenu(menu.name, menu.button) }}
      {{ dismissIndependentMenu(menu.name, menu.button + " Close") }}
    {% endif %}
  {% endif %}

{% endmacro %}