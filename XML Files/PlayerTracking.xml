{% import 'Utils.xml' as util %}
{% import 'Start.xml' as start %}

{% macro onSpawn() %}
  {% do track("onSpawn", caller) %}
{% endmacro %}

{% macro onRespawn() %}
  {% do track("onRespawn", caller) %}
{% endmacro %}

{% macro onDestroy() %}
  {% do track("onPlayerDestroy", caller) %}
{% endmacro %}

{% call start.onStart() %}
  {% for ship in util.shipConfigs %}
    <set_variable name="Ship{{ ship.id }} Status" value="1.0" integer="yes" />
  {% endfor %}
  <set_variable name="shipCount" value="0.0" integer="yes" />
{% endcall %}

  <event name="All Inactive" id_arme="970521f0-180e-45e2-8cf8-693a4c3b200b" parent_id_arme="da1f4d06-129f-463c-a1e6-d7a4eae746b1">
    <if_variable name="Sandbox Activation" comparator="EQUALS" value="0.0" />
    <if_variable name="shipCount" comparator="EQUALS" value="0.0" />
    <set_timer name="Mission End" seconds="3" />
    <set_variable name="Mission End" value="1.0" integer="yes" />
    <set_variable name="Sector Locked" value="1.0" integer="yes" />
    <set_variable name="Sandbox Activation" value="100.0" integer="yes" />
  </event>

  {% for ship in util.shipConfigs %}
  <event name="Ship{{ ship.id }} Active">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="1.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    <set_variable name="shipCount" value="shipCount+1" integer="yes" />
    <!--Determine Max Stores-->
    <get_object_property property="countHoming" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}HomingMax" />
    <get_object_property property="countNuke" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}NukeMax" />
    <get_object_property property="countMine" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}MineMax" />
    <get_object_property property="countEMP" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}EMPMax" />
    <get_object_property property="countShk" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}ShkMax" />
    <get_object_property property="countBea" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}BeaMax" />
    <get_object_property property="countPro" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}ProMax" />
    <get_object_property property="countTag" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}TagMax" />
    <!--Set Initial Stores-->
    <set_variable name="Ship{{ ship.id }}HomingCurrent" value="Ship{{ ship.id }}HomingMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}NukeCurrent" value="Ship{{ ship.id }}NukeMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}MineCurrent" value="Ship{{ ship.id }}MineMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}EMPCurrent" value="Ship{{ ship.id }}EMPMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}ShkCurrent" value="Ship{{ ship.id }}ShkMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}BeaCurrent" value="Ship{{ ship.id }}BeaMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}ProCurrent" value="Ship{{ ship.id }}ProMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}TagCurrent" value="Ship{{ ship.id }}TagMax" integer="yes" />
    <!--Additional Trackers-->
    <set_variable name="{{ ship.shuttle }} Status" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }}Silent" value="0.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="2.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for caller in retrieve("onSpawn") %}
      {{ caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Inactive">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="1.0" />
    <if_not_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Sandbox Activation" comparator="EQUALS" value="0.0" />
    <set_variable name="Ship{{ ship.id }} Ready Grid A" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Grid E" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Grid 1" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Grid 5" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner A1" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner A5" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner E1" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner E5" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="4.0" integer="yes" />
  </event>
  <event name="Ship{{ ship.id }} Respawns">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="3.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    <set_side_value value="playerSide" player_slot="{{ ship.slot }}" />
    <set_variable name="shipCount" value="shipCount+1" integer="yes" />
    <set_object_property property="countHoming" value="Ship{{ ship.id }}HomingRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countNuke" value="Ship{{ ship.id }}NukeRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countMine" value="Ship{{ ship.id }}MineRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countEMP" value="Ship{{ ship.id }}EMPRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countShk" value="Ship{{ ship.id }}ShkRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countBea" value="Ship{{ ship.id }}BeaRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countPro" value="Ship{{ ship.id }}ProRespawn" player_slot="{{ ship.slot }}" />
    <set_object_property property="countTag" value="Ship{{ ship.id }}TagRespawn" player_slot="{{ ship.slot }}" />
    <set_variable name="{{ ship.shuttle }} Status" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="2.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }}Silent" value="0.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for caller in retrieve("onSpawn") %}
      {{ caller(ship) }}
    {% endfor %}
    {% for caller in retrieve("onRespawn") %}
      {{ caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Late Spawn" id_arme="90c2cd5f-d28f-4d6d-8131-595a3d9028c3" parent_id_arme="fa4ad454-aa24-490a-b2c9-33c8d317e838">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="4.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Sandbox Activation" comparator="EQUALS" value="0.0" />
    <set_variable name="shipCount" value="shipCount+1" integer="yes" />
    <!--Determine Max Stores-->
    <get_object_property property="countHoming" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}HomingMax" />
    <get_object_property property="countNuke" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}NukeMax" />
    <get_object_property property="countMine" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}MineMax" />
    <get_object_property property="countEMP" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}EMPMax" />
    <get_object_property property="countShk" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}ShkMax" />
    <get_object_property property="countBea" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}BeaMax" />
    <get_object_property property="countPro" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}ProMax" />
    <get_object_property property="countTag" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}TagMax" />
    <!--Set Initial Stores-->
    <set_variable name="Ship{{ ship.id }}HomingCurrent" value="Ship{{ ship.id }}HomingMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}NukeCurrent" value="Ship{{ ship.id }}NukeMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}MineCurrent" value="Ship{{ ship.id }}MineMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}EMPCurrent" value="Ship{{ ship.id }}EMPMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}ShkCurrent" value="Ship{{ ship.id }}ShkMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}BeaCurrent" value="Ship{{ ship.id }}BeaMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}ProCurrent" value="Ship{{ ship.id }}ProMax" integer="yes" />
    <set_variable name="Ship{{ ship.id }}TagCurrent" value="Ship{{ ship.id }}TagMax" integer="yes" />
    <!--Additional Trackers-->
    <set_variable name="{{ ship.shuttle }} Status" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }}Silent" value="0.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="2.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for caller in retrieve("onSpawn") %}
      {{ caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Destroyed" id_arme="defc1070-b7d2-4e08-b196-18fe9d407622" parent_id_arme="5e24183b-0344-45c6-9981-1b2d210778d7">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="2.0" />
    <if_not_exists player_slot="0" />
    <set_variable name="Ship{{ ship.id }} Ready Grid A" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Grid E" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Grid 1" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Grid 5" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner A1" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner A5" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner E1" value="1.0" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Ready Corner E5" value="1.0" integer="yes" />
    <set_variable name="shipCount" value="shipCount-1" integer="yes" />
    <set_variable name="Ship{{ ship.id }}HomingRespawn" value="Ship{{ ship.id }}HomingCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}NukeRespawn" value="Ship{{ ship.id }}NukeCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}MineRespawn" value="Ship{{ ship.id }}MineCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}EMPRespawn" value="Ship{{ ship.id }}EMPCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}ShkRespawn" value="Ship{{ ship.id }}ShkCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}BeaRespawn" value="Ship{{ ship.id }}BeaCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}ProRespawn" value="Ship{{ ship.id }}ProCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }}TagRespawn" value="Ship{{ ship.id }}TagCurrent" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="3.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for caller in retrieve("onPlayerDestroy") %}
      {{ caller(ship) }}
    {% endfor %}
  </event>
  {% endfor %}
