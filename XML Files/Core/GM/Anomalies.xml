{% import 'Core/Menus.xml' as menu %}
{% import 'Constants.xml' as const %}

{{ menu.addDismissableSubmenu("Anomalies", menu.main.poi) }}

{% for anomaly in const.anomalies %}
  {% call menu.onMenuClick(anomaly.type, "Anomalies") %}
    <create type="Anomaly" pickupType="{{ anomaly.id }}" use_gm_position="" name="--" />
    <set_variable name="Name Assign" value="1.0" integer="yes" />
  {% endcall %}
{% endfor %}
