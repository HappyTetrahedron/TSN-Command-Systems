{% import 'Tools/Picker.xml' as picker %}
{% import 'Constants.xml' as util %}
{% import 'Core/Menus.xml' as menu %}
{% import 'Core/FleetSystem/AIDefinitions.xml' as aidefs %}

{% set sides = range(1, 14)|list %}
{% do sides.__setitem__(1, "2 PLYR") %}
{% call(choice) picker.PickerStateless("SwSide", "Switch Side", sides, 40, 690) %}
  <set_variable name="AI_Reassign_ChangeToSide" value="{{ 2 if choice == '2 PLYR' else choice }}.0" integer="yes" />
  <set_variable name="ReassignAI" value="1000.0" integer="yes" />
{% endcall %}

{% call(choice) picker.Picker("Dif", "Change", range(1, 11), "Difficulty", g.data.difficulty or 10, 40, 445) %}
  <set_difficulty_level value="{{ choice }}" />
{% endcall %}

{% set aiNames = ["Default"] %}
{% for ai in aidefs.overrideAIs.values() %}
  {% do aiNames.append(ai.name) %}
{% endfor %}
{% call(choice) picker.Picker("AI", "Change", aiNames, "AI", 1, 100, 134) %}
  {% if choice == "Default" %}
    <set_variable name="AI Override" value="0.0" integer="yes" />
  {% else %}
    {% for id, ai in aidefs.overrideAIs.items() if ai.name == choice %}
      <set_variable name="AISetting" value="{{ id }}.0" integer="yes" />
      <set_variable name="AI Override" value="1.0" integer="yes" />
    {% endfor %}
  {% endif %}
  <set_difficulty_level value="{{ choice }}" />
{% endcall %}

{% call(isCreate) menu.addStatementToMenu("GM AIOverride Pickers", menu.main.spawn) %}
    <set_variable name="AIPicker_Should_Show" value="{{ 1 if isCreate else 0 }}.0" integer="yes" />
{% endcall %}
{% call(isCreate) menu.addStatementToMenu("GM AI Pickers", menu.main.ai) %}
    <set_variable name="SwSidePicker_Should_Show" value="{{ 1 if isCreate else 0 }}.0" integer="yes" />
    <set_variable name="DifPicker_Should_Show" value="{{ 1 if isCreate else 0 }}.0" integer="yes" />
{% endcall %}


  {% set dirX = 70 %}
  {% set dirY = 540 %}
  {% call menu.onButtonClick("STOP    O", menu.main.ai, pos={
    "x":dirX,
    "y":dirY,
    "w":28,
    "h":28,
  }) %}
    <set_variable name="ReassignAI" value="1030.0" integer="yes" />
  {% endcall %}

  {% for ai_code, props in {
    "1031.0": {
      "name": "move",
    },
  }.items() %}
    {% for dir, text in {
      0: "0   /\\",
      45: "45   //",
      90: "90   >>",
      135: "135   \\\\",
      180: "180   V",
      225: "225   //",
      270: "270   <<",
      315: "315   \\\\",
    }.items() %}
      {% call menu.onButtonClick(text, menu.main.ai, pos={
        "x":dirX + ((-30) if (dir+135)%360 <= 90 else (30 if (dir+315)%360 <= 90 else 0)),
        "y":dirY + ((-30) if (dir+45)%360 <= 90 else (30 if (dir+225)%360 <= 90 else 0)),
        "w":28,
        "h":28,
      }) %}
        <set_variable name="AI_Reassign_ThrottleDir" value="{{ dir }}.0" integer="yes" />
        <set_variable name="ReassignAI" value="{{ ai_code }}" integer="yes" />
      {% endcall %}
    {% endfor %}
  {% endfor %}

  {% call menu.onButtonClick("Speed +0.6", menu.main.ai, pos={
    "x":88,
    "y":600,
    "w":40,
    "h":28,
  }) %}
    <set_variable name="ReassignAI" value="1040.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Speed -0.6", menu.main.ai, pos={
    "x":40,
    "y":600,
    "w":40,
    "h":28,
  }) %}
    <set_variable name="ReassignAI" value="1041.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("GrpToGM", menu.main.ai, pos={
    "x":40,
    "y":480,
    "w":88,
    "h":28,
  }) %}
    <set_variable name="ReassignAI" value="1025.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Del Grp", menu.main.ai, pos={
    "x":40,
    "y":630,
    "w":88,
    "h":28,
  }) %}
    <set_variable name="ReassignAI" value="1999.0" integer="yes" />
  {% endcall %}

  {% call menu.onButtonClick("Unsurrender", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="1022.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Surrender", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="1021.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("DefaultAI", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="1.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("EliteAI", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="6.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Hunt Plyr", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="2.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Hunt Bse", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="3.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Hunt Ntrl", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="13.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("PirateAI", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="101.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("AllyAI", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="60.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Guard Bse", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="4.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("GoToBase", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="51.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Noncombat", menu.ai.aicommands) %}
    <set_variable name="ReassignAI" value="50.0" integer="yes" />
  {% endcall %}

  {{ menu.addDismissableSubmenu("Specials", menu.ai.aicommands) }}


  {% for ability in util.shipAbilities %}
    {% call menu.onMenuClick("Ship\\" + ability.name, "Specials") %}
      <set_special use_gm_selection="" ship="{{ ability.id }}" />
    {% endcall %}
  {% endfor %}
  {% for ability in util.captainAbilities %}
    {% call menu.onMenuClick("Captain\\" + ability.name, "Specials") %}
      <set_special use_gm_selection="" captain="{{ ability.id }}" />
    {% endcall %}
  {% endfor %}
  {% for special in util.specials %}
    {% call menu.onMenuClick("Add\\" + special, "Specials") %}
      <set_special use_gm_selection="" ability="{{ special }}" />
    {% endcall %}
    {% call menu.onMenuClick("Clear\\" + special, "Specials") %}
      <set_special use_gm_selection="" clear="yes" ability="{{ special }}" />
    {% endcall %}
  {% endfor %}
  {% call menu.onMenuClick("Clear\\Clear All", "Specials") %}
    {% for special in util.specials %}
      <set_special use_gm_selection="" clear="yes" ability="{{ special }}" />
    {% endfor %}
  {% endcall %}
