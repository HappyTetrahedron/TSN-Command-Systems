{% import 'Core/Menus.xml' as menu %}
{% import 'Constants.xml' as const %}

{{ menu.addDismissableSubmenu("RepairDamage", menu.main.interaction) }}


{% call menu.onMenuClick("Single Mine", "Mines") %}
  <create count="1" type="mines" use_gm_position="" radius="1" />
{% endcall %}

{% for system, id in const.systemIdentifiers.items() %}
  {% call menu.onMenuClick("Repair\\" + system|title , "RepairDamage") %}
    {% for i in range(7) %}
      <set_player_grid_damage value="0.0" use_gm_selection=" " index="{{ i }}" systemType="{{ id }}" countFrom="front" />
    {% endfor %}
  {% endcall %}
  {% call menu.onMenuClick("Damage\\" + system|title , "RepairDamage") %}
    {% for i in range(7) %}
      <set_player_grid_damage value="1.0" use_gm_selection=" " index="{{ i }}" systemType="{{ id }}" countFrom="front" />
    {% endfor %}
  {% endcall %}
{% endfor %}
{% for damcon in range(3) %}
  {% call menu.onMenuClick("Repair\\DamCon " + (damcon+1)|string , "RepairDamage") %}
    <set_damcon_members value="6" team_index="{{ damcon }}" use_gm_selection=" " />
  {% endcall %}
  {% call menu.onMenuClick("Damage\\DamCon " + (damcon+1)|string , "RepairDamage") %}
    <set_damcon_members value="0" team_index="{{ damcon }}" use_gm_selection=" " />
  {% endcall %}
{% endfor %}

{% call menu.onMenuClick("Incapacitate", "RepairDamage") %}
  {% for system, property in const.systemIdentifiers.items() %}
    {% for i in range(6) %}
      <set_player_grid_damage systemType="{{ property }}" use_gm_selection="" value="1.0" countFrom="front" index="{{ i }}" />
    {% endfor %}
  {% endfor %}
  {% for i in range(3) %}
    <set_damcon_members use_gm_selection="" team_index="{{ i }}" value="0" />
  {% endfor %}
{% endcall %}

{% call menu.onMenuClick("Full Repair", "RepairDamage") %}
  {% for system, property in const.systemIdentifiers.items() %}
    {% for i in range(6) %}
      <set_player_grid_damage systemType="{{ property }}" use_gm_selection="" value="0.0" countFrom="front" index="{{ i }}" />
    {% endfor %}
  {% endfor %}
  {% for i in range(3) %}
    <set_damcon_members use_gm_selection="" team_index="{{ i }}" value="6" />
  {% endfor %}
{% endcall %}

{% for ship in const.shipConfigs %}
  {% call menu.onMenuClick("Random Dmg\\Ship " + ship.id|string , "RepairDamage") %}
    <set_gm_button text="Dmg Ship{{ ship.id }}" x="{{ 630 + 90 * (ship.slot|int % 2) }}" y="{{ 60 + 30 * ((ship.slot|int/2)|int) }}" h="30" w="90" />
    <set_variable name="RandomDamageShip{{ ship.id }}" value="1.0" integer="yes" />
    <set_timer name="Ship{{ ship.id }}DamageTimer" seconds="1" />
  {% endcall %}
  <event name="Ship{{ ship.id }} Off">
    <if_gm_button text="Dmg Ship{{ ship.id }}" />
    <clear_gm_button text="Dmg Ship{{ ship.id }}" />
    <set_variable name="RandomDamageShip{{ ship.id }}" value="0.0" integer="yes" />
  </event>
{% endfor %}

{% for ship in const.shipConfigs %}
  <event name="Select System">
    <if_variable name="RandomDamageShip{{ ship.id }}" comparator="EQUALS" value="1.0" />
    <if_timer_finished name="Ship{{ ship.id }}DamageTimer" />
    <if_variable name="Ship{{ ship.id }}DamageType" comparator="EQUALS" value="0.0" />
    <if_variable name="Ship{{ ship.id }}NodeNumber" comparator="EQUALS" value="0.0" />
    <set_variable name="Ship{{ ship.id }}NodeNumber" randomIntLow="1" randomIntHigh="4" integer="yes" />
    <set_variable name="Ship{{ ship.id }}DamageType" randomIntLow="1" randomIntHigh="8" integer="yes" />
    <set_variable name="Ship{{ ship.id }}RandomTimer" randomIntLow="3" randomIntHigh="24" />
    <set_timer name="Ship{{ ship.id }}DamageTimer" seconds="Ship{{ ship.id }}RandomTimer" />
  </event>
  {% for system, name in const.systemIdentifiers.items() %}
    {% set systemID = loop.index %}
    {% for i in range(4) %}
      <event name="Damage {{ system }} {{ i }}">
        <if_variable name="RandomDamageShip{{ ship.id }}" comparator="EQUALS" value="1.0" />
        <if_variable name="Ship{{ ship.id }}DamageType" comparator="EQUALS" value="{{ systemID }}.0" />
        <if_variable name="Ship{{ ship.id }}NodeNumber" comparator="EQUALS" value="{{ i+1 }}.0" />
        <if_timer_finished name="Ship{{ ship.id }}DamageTimer" />
        <set_player_grid_damage value="1.0" player_slot="{{ ship.slot }}" index="{{ i }}" systemType="{{ name }}" countFrom="front" />
        <set_variable name="Ship{{ ship.id }}NodeNumber" value="0.0" integer="yes" />
        <set_variable name="Ship{{ ship.id }}DamageType" value="0.0" integer="yes" />
        <set_timer name="Ship{{ ship.id }}DamageTimer" seconds="1" />
      </event>
    {% endfor %}
  {% endfor %}
{% endfor %}
