  {% import 'Constants.xml' as const %}

  <folder_arme name="Custom Config" id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837" />
  {% for ship in const.shipConfigs %}
  <event name="Ship{{ ship.id }} Ordnance" id_arme="56643add-a468-4dc1-9549-d6ed1e6757ad" parent_id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837">
    <if_variable name="Ship{{ ship.id }}OrdnanceConfig" comparator="NOT" value="1.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    {% for type, count in g.data.get("ordnance", {}).get("ship" + ship.id, {}).items() %}
    {% if count >= 0 %}
      <set_object_property property="{{ const.ordnanceIdentifiers[type] }}" value="{{ count }}" player_slot="{{ ship.slot }}" />
    {% endif %}
    {% endfor %}
    <set_variable name="Ship{{ ship.id }}OrdnanceConfig" value="1.0" integer="yes" />
  </event>

  <event name="Ship{{ ship.id }} Ordnance Reset" id_arme="56643add-a468-4dc1-9549-d6ed1e6757ad" parent_id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837">
  <if_variable name="Ship{{ ship.id }}OrdnanceConfig" comparator="EQUALS" value="1.0" />
    <if_not_exists player_slot="{{ ship.slot }}" />
    <set_variable name="Ship{{ ship.id }}OrdnanceConfig" value="0.0" integer="yes" />
  </event>
{% endfor %}

  <event name="Cargo" id_arme="ed565860-810a-4932-b977-bb8bfdd04316" parent_id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837">
    <if_variable name="Custom Config" comparator="EQUALS" value="1.0" />
  {% for ship in const.shipConfigs %}
    {% for cargo in const.cargoTypes if not cargo.is_nothing %}
    <set_variable name="Ship{{ ship.id }}{{ cargo.variable }}" value="{{ g.data.get("cargo", {}).get("ship" + ship.id, {}).get(cargo.api_name, cargo.default_count) }}" integer="yes" />
    {% endfor %}
  {% endfor %}
    <set_variable name="Custom Config" value="2.0" integer="yes" />
  </event>
