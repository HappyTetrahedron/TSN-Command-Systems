{% import 'Core/Start.xml' as start %}

{% call start.onStart("AI Random Properties") %}
    <set_variable name="Random Coordinates" value="1.0" integer="yes" />
    <set_variable name="Random Direction" value="1.0" integer="yes" />
    <set_variable name="Fleetnumber" value="1.0" integer="yes" />
{% endcall %}

{# Handlers for setting random coordinates, direction, and multiplier. Need to be included before spawn / AI config events. #}
  <event name="Random Coordinates" id_arme="7c7265dd-f0de-4d29-9f42-9f23d1e09a4e" parent_id_arme="e5a3ec26-6d23-4bb8-9698-be3f70d38947">
    <if_variable name="Random Coordinates" comparator="EQUALS" value="1.0" />
    <set_variable name="GridACoordinatesZ" randomIntLow="20" randomIntHigh="300" />
    <set_variable name="GridACoordinatesX" randomIntLow="10" randomIntHigh="990" />
    <set_variable name="GridECoordinatesZ" randomIntLow="700" randomIntHigh="970" />
    <set_variable name="GridECoordinatesX" randomIntLow="10" randomIntHigh="990" />
    <set_variable name="Grid1CoordinatesX" randomIntLow="700" randomIntHigh="970" />
    <set_variable name="Grid1CoordinatesZ" randomIntLow="10" randomIntHigh="990" />
    <set_variable name="Grid5CoordinatesX" randomIntLow="20" randomIntHigh="300" />
    <set_variable name="Grid5CoordinatesZ" randomIntLow="10" randomIntHigh="990" />
    <set_variable name="RandomCoordinateX" randomIntLow="20" randomIntHigh="980" />
    <set_variable name="RandomCoordinateZ" randomIntLow="20" randomIntHigh="980" />
    <set_variable name="Random Coordinates" value="0.0" integer="yes" />
  </event>
  <event name="Random Direction" id_arme="da8304a5-e55d-4f22-870c-128c2d0850ad" parent_id_arme="e5a3ec26-6d23-4bb8-9698-be3f70d38947">
    <if_variable name="Random Direction" comparator="EQUALS" value="1.0" />
    <set_variable name="randX" randomIntLow="0" randomIntHigh="100000" />
    <set_variable name="randZ" randomIntLow="0" randomIntHigh="100000" />
    <set_variable name="Degrees" randomIntLow="1" randomIntHigh="360" />
    <set_variable name="Random Direction" value="0.0" integer="yes" />
  </event>
  <event name="Random Multiplier" id_arme="ad80a078-9de4-42f6-93c9-99969c407ad7" parent_id_arme="e5a3ec26-6d23-4bb8-9698-be3f70d38947">
    <if_variable name="Random Multiplier" comparator="EQUALS" value="1.0" />
    <set_variable name="randMult" randomIntLow="1" randomIntHigh="5" integer="yes" />
    <set_variable name="Random Multiplier" value="0.0" integer="yes" />
  </event>

  <event name="Fleet Spacing" id_arme="54b321e2-22c5-4b50-8dcd-4006516aec4c" parent_id_arme="0e4d583e-5dea-4097-a675-97423f6f29e4">
    <if_variable name="Fleet Settings" comparator="EQUALS" value="1.0" />
    <set_fleet_property property="fleetSpacing" value="500.0" fleetIndex="Fleetnumber" />
    <set_fleet_property property="fleetMaxRadius" value="3000.0" fleetIndex="Fleetnumber" />
    <set_variable name="Fleet Settings" value="2.0" />
  </event>
  <event name="Increment Fleet Number" id_arme="85906409-aa9b-4aa7-b958-c804106dff74" parent_id_arme="0e4d583e-5dea-4097-a675-97423f6f29e4">
    <if_variable name="Fleet Settings" comparator="EQUALS" value="2.0" />
    <if_variable name="Fleetnumber" comparator="GREATER_EQUAL" value="1.0" />
    <if_variable name="Fleetnumber" comparator="LESS" value="99.0" />
    <set_variable name="Fleetnumber" value="Fleetnumber+1" integer="yes" />
    <set_variable name="Fleet Settings" value="0.0" />
  </event>
  <event name="Fleet Number Reset" id_arme="7156fe37-07f4-4a30-a11c-6d7b98830052" parent_id_arme="0e4d583e-5dea-4097-a675-97423f6f29e4">
    <if_variable name="Fleet Settings" comparator="EQUALS" value="2.0" />
    <if_variable name="Fleetnumber" comparator="GREATER_EQUAL" value="99.0" />
    <set_variable name="Fleetnumber" value="1.0" integer="yes" />
    <set_variable name="Fleet Settings" value="0.0" />
  </event>
  <folder_arme name="Default AI Override" id_arme="70c29f72-0adf-4368-8e52-9c49fccf287a" parent_id_arme="047cc0b3-ea2a-4991-98c9-400c3bbcd6c5" />
  <event name="Override Default AI" id_arme="f12c82cc-6107-483b-9b99-b6c4c0613b46" parent_id_arme="70c29f72-0adf-4368-8e52-9c49fccf287a">
    <if_variable name="AI Override" comparator="EQUALS" value="1.0" />
    <if_variable name="Auto AI Type" comparator="NOT" value="AISetting" />
    <set_variable name="Auto AI Type" value="AISetting" integer="yes" />
  </event>
