{% macro AI_ChangeSide(names) %}
  {% for name in names %}
    <set_side_value value="AI_Reassign_ChangeToSide" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_Surrender(names) %}
  {% for name in names %}
    <clear_ai {{ nn(name) }} />
    <set_object_property property="hasSurrendered" value="10" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_UnSurrender(names) %}
  {% for name in names %}
    <set_object_property property="hasSurrendered" value="0" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_JumpToGM(names) %}
  {% for name in names %}
    <set_to_gm_position {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_FullStop(names) %}
  {% for name in names %}
    <set_object_property property="topSpeed" value="0.0" {{ nn(name) }} />
    <clear_ai {{ nn(name) }} />
    <add_ai type="CHASE_STATION" value1="500" {{ nn(name) }} />
    <add_ai type="CHASE_AI_SHIP" value1="1000" value2="500" {{ nn(name) }} />
    <add_ai type="CHASE_PLAYER" value1="1000" value2="500" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_MoveDirection(names) %}
  {% for name in names %}
    <clear_ai {{ nn(name) }} />
    <add_ai type="DIR_THROTTLE" value1="AI_Reassign_ThrottleDir" value2="4.0" {{ nn(name) }} />
    <add_ai type="CHASE_STATION" value1="500" {{ nn(name) }} />
    <add_ai type="CHASE_AI_SHIP" value1="500" value2="500" {{ nn(name) }} />
    <add_ai type="CHASE_PLAYER" value1="3000" value2="500" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_IncreaseSpeed(names) %}
  {% for name in names %}
    <addto_object_property value="0.6" property="topSpeed" {{ nn(name) }} />
    <set_object_property property="throttle" value="4.0" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_DecreaseSpeed(names) %}
  {% for name in names %}
    <addto_object_property value="0-0.6" property="topSpeed" {{ nn(name) }} />
    <set_object_property property="throttle" value="4.0" {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

{% macro AI_Delete(names) %}
  {% for name in names %}
    <destroy {{ nn(name) }} />
  {% endfor %}
{% endmacro %}

