{% import 'Constants.xml' as const %}
{% import 'Core/Start.xml' as start %}

{% macro onSpawn(identifier) %}
  {% do track("onSpawn", {"caller": caller, "name": identifier}, identifier) %}
{% endmacro %}

{% macro onRespawn(identifier) %}
  {% do track("onRespawn", {"caller": caller, "name": identifier}, identifier) %}
{% endmacro %}

{% macro onDestroy(identifier) %}
  {% do track("onPlayerDestroy", {"caller": caller, "name": identifier}, identifier) %}
{% endmacro %}

{% macro onInactive(identifier) %}
  {% do track("onPlayerInactive", {"caller": caller, "name": identifier}, identifier) %}
{% endmacro %}

{% call start.onStart("PlayerTracking") %}
  {% for ship in const.shipConfigs %}
    <set_variable name="Ship{{ ship.id }} Status" value="1.0" integer="yes" />
  {% endfor %}
  <set_variable name="shipCount" value="0.0" integer="yes" />
{% endcall %}

  <event name="All Inactive" id_arme="970521f0-180e-45e2-8cf8-693a4c3b200b" parent_id_arme="da1f4d06-129f-463c-a1e6-d7a4eae746b1">
    <if_variable name="Sandbox Activation" comparator="EQUALS" value="0.0" />
    <if_variable name="shipCount" comparator="EQUALS" value="0.0" />
    <set_timer name="Mission End" seconds="60" />
    <set_variable name="Mission End" value="1.0" integer="yes" />
    <set_variable name="Sandbox Activation" value="100.0" integer="yes" />
  </event>

  {% for ship in const.shipConfigs %}
  <event name="Ship{{ ship.id }} Active">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="1.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    <set_variable name="shipCount" value="shipCount+1" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="2.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for hook in retrieve("onSpawn") %}
      <!--{{ hook.name }}-->
      {{ hook.caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Inactive">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="1.0" />
    <if_not_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Sandbox Activation" comparator="EQUALS" value="0.0" />
    <set_variable name="Ship{{ ship.id }} Status" value="4.0" integer="yes" />
    {% for hook in retrieve("onPlayerInactive") %}
      <!--{{ hook.name }}-->
      {{ hook.caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Respawns">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="3.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    <set_side_value value="playerSide" player_slot="{{ ship.slot }}" />
    <set_variable name="shipCount" value="shipCount+1" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="2.0" integer="yes" />
    <set_variable name="Mission End" value="0.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for hook in retrieve("onSpawn") %}
      <!--{{ hook.name }} (onSpawn)-->
      {{ hook.caller(ship) }}
    {% endfor %}
    {% for hook in retrieve("onRespawn") %}
      <!--{{ hook.name }} (onRespawn)-->
      {{ hook.caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Late Spawn" id_arme="90c2cd5f-d28f-4d6d-8131-595a3d9028c3" parent_id_arme="fa4ad454-aa24-490a-b2c9-33c8d317e838">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="4.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Sandbox Activation" comparator="EQUALS" value="0.0" />
    <set_variable name="shipCount" value="shipCount+1" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="2.0" integer="yes" />
    <set_variable name="Mission End" value="0.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for hook in retrieve("onSpawn") %}
      <!--{{ hook.name }}-->
      {{ hook.caller(ship) }}
    {% endfor %}
  </event>
  <event name="Ship{{ ship.id }} Destroyed" id_arme="defc1070-b7d2-4e08-b196-18fe9d407622" parent_id_arme="5e24183b-0344-45c6-9981-1b2d210778d7">
    <if_variable name="Ship{{ ship.id }} Status" comparator="EQUALS" value="2.0" />
    <if_not_exists player_slot="{{ ship.slot }}" />
    <set_variable name="shipCount" value="shipCount-1" integer="yes" />
    <set_variable name="Ship{{ ship.id }} Status" value="3.0" integer="yes" />
    <!--Dynamic Variables-->
    {% for hook in retrieve("onPlayerDestroy") %}
      <!--{{ hook.name }}-->
      {{ hook.caller(ship) }}
    {% endfor %}
  </event>
  {% endfor %}
