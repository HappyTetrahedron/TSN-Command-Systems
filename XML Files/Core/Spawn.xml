{% import 'Constants.xml' as const %}
{% import 'Tools/Picker.xml' as picker %}
{% import 'Core/Menus.xml' as menu %}
{% import 'Core/Start.xml' as start %}
{% import 'Core/Destroy.xml' as destroy %}

{% set factions = const.spawnFactions %}

{% macro spawn(factionKey, category, name, autoAI=0, nameAssign=False, randomDir=False, fleetSettings=False) %}
  {% set outercaller = caller %}
  {% call menu.onMenuClickRaw(category + "\\" + name, "spawn" + factionKey) %}
    {{ outercaller() }}
    {% if autoAI > 0 %}
      <set_variable name="Auto AI Type" value="{{ autoAI }}.0" integer="yes" />
    {% endif %}
    {% if randomDir %}
      <set_variable name="Random Direction" value="1.0" />
    {% endif %}
    {% if nameAssign %}
      <set_variable name="Name Assign" value="1.0" integer="yes" />
    {% endif %}
    {% if fleetSettings %}
      <set_variable name="Fleet Settings" value="1.0" integer="yes" />
    {% endif %}
  {% endcall %}
{% endmacro %}

{% for _, fac in factions.items() %}
  {{ menu.addMutexSubmenu("spawn" + fac.key, menu.main.spawn, button=fac.name, mutexKey="Spawn", mutexID=fac.key) }}
  {{ menu.addVarToMenuButton("defaultSettings", "spawn" + fac.key, "SideValue", fac.defaultSide) }}
{% endfor %}

{% macro scaffoldNumbered(name_template, identifier, counter, amount=5) %}
  {% call start.onStart("Spawn: " + identifier) %}
    <set_variable name="{{ counter }}" value="1.0" integer="yes" />
  {% endcall %}
  {% call destroy.onDestroy("Spawn: " + identifier) %}
    {% for i in range(1, amount+1) %}
      {% set name = name_template|replace("|" + counter + "|", i|string) %}
      <destroy name="{{ name }}" />
    {% endfor %}
  {% endcall %}
  <event name="All {{ identifier }} Spawned">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="1.0" />
    {% for i in range(1, amount+1) %}
      {% set name = name_template|replace("|" + counter + "|", i|string) %}
      <if_exists name="{{ name }}" />
    {% endfor %}
    <set_variable name="Spawn_{{ identifier }}" value="0.0" integer="yes" />
  </event>
  <event name="{{ identifier }} Skip">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="1.0" />
    <if_exists name="{{ identifier }} |lifepodNumber|" />
    <set_variable name="Spawn_{{ identifier }}" value="4.0" integer="yes" />
  </event>
  <event name="Increment {{ identifier }} Number">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="4.0" />
    <if_variable name="{{ counter }}" comparator="LESS" value="{{ amount }}.0" />
    <set_variable name="{{ counter }}" value="{{ counter }}+1" integer="yes" />
    <set_variable name="Spawn_{{ identifier }}" value="1.0" integer="yes" />
  </event>
  <event name="Reset {{ identifier }} Number">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="4.0" />
    <if_variable name="{{ counter }}" comparator="GREATER_EQUAL" value="{{ amount }}.0" />
    <set_variable name="{{ counter }}" value="1.0" integer="yes" />
    <set_variable name="Spawn_{{ identifier }}" value="1.0" integer="yes" />
  </event>
  <event name="Increment {{ identifier }} Number">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="3.0" />
    <if_variable name="{{ counter }}" comparator="LESS" value="{{ amount }}.0" />
    <set_variable name="{{ counter }}" value="{{ counter }}+1" integer="yes" />
    <set_variable name="Spawn_{{ identifier }}" value="0.0" integer="yes" />
  </event>
  <event name="Reset {{ identifier }} Number">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="3.0" />
    <if_variable name="{{ counter }}" comparator="GREATER_EQUAL" value="{{ amount }}.0" />
    <set_variable name="{{ counter }}" value="1.0" integer="yes" />
    <set_variable name="Spawn_{{ identifier }}" value="0.0" integer="yes" />
  </event>
{% endmacro %}

{% macro createNumberedConditional(name_template, button, menuName, identifier, counter, optionID, isButton=False) %}
  {% if isButton %}
    {% call menu.onButtonClick(button, menuName) %}
      <set_variable name="Spawn_{{ identifier }}" value="1.0" integer="yes" />
      <set_variable name="Condition_{{ identifier }}" value="{{ optionID}}.0" integer="yes" />
    {% endcall %}
  {% else %}
    {% call menu.onMenuClick(button, menuName) %}
      <set_variable name="Spawn_{{ identifier }}" value="1.0" integer="yes" />
      <set_variable name="Condition_{{ identifier }}" value="{{ optionID}}.0" integer="yes" />
    {% endcall %}
  {% endif %}
  <event name="{{ button }} Spawn">
    <if_variable name="Spawn_{{ identifier }}" comparator="EQUALS" value="1.0" />
    <if_variable name="Condition_{{ identifier }}" comparator="EQUALS" value="{{ optionID }}.0" />
    <if_not_exists name="{{ name_template }}" />
    {{ caller() }}
    <set_variable name="Spawn_{{ identifier }}" value="3.0" integer="yes" />
    <set_variable name="Condition_{{ identifier }}" value="0.0" integer="yes" />
  </event>
{% endmacro %}

{% macro createNumbered(name_template, button, menuName, counter, amount=5, isButton=False) %}
  {% if isButton %}
    {% call menu.onButtonClick(button, menuName) %}
      <set_variable name="Spawn_{{ button }}" value="1.0" integer="yes" />
    {% endcall %}
  {% else %}
    {% call menu.onMenuClick(button, menuName) %}
      <set_variable name="Spawn_{{ button }}" value="1.0" integer="yes" />
    {% endcall %}
  {% endif %}
  {{ scaffoldNumbered(name_template, button,  counter, amount) }}
  <event name="{{ button }} Spawn">
    <if_variable name="Spawn_{{ button }}" comparator="EQUALS" value="1.0" />
    <if_not_exists name="{{ button }} |{{ counter }}|" />
    {{ caller() }}
    <set_variable name="Spawn_{{ button }}" value="3.0" integer="yes" />
  </event>
{% endmacro %}

