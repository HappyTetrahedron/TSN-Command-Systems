    <!--Shuttle Operations-->
    <set_variable name="ShuttleSelect" value="0.0" integer="yes" />
    <set_variable name="OperationType" value="0.0" integer="yes" />
    <!--Adding Shuttles-->
    {% for ship in util.shipConfigs %}
      <set_player_carried_type player_slot="{{ ship.slot }}" bay_slot="0" hullID="102" name="{{ ship.shuttle }}" />
    {% endfor %}
    <!--Sandbox Activation-->
    <set_variable name="GM Mode" value="0.0" integer="yes" />
    <set_variable name="GM Controls" value="0.0" integer="yes" />
    <set_timer name="Sandbox Activation" seconds="5" />
