{% import 'Utils.xml' as util %}

{% macro onStart() %}
  {% do track("onStart", caller) %}
{% endmacro %}

{% set data = g.data if g else {} %}
{% set version = g.version if g else '\" />' %}

  <start name="Start" id_arme="8bf1c774-cd5c-41e1-b463-2a543cc7fbd4">
    <!--Configurations-->
    <set_variable name="Clear" value="11.0" integer="yes" />
    <set_difficulty_level value="{{ data.difficulty or 10 }}" />
    <big_message title="The TSN Universe" subtitle1="Tetra's Fork Version {{ version }}" subtitle2="Maps:{% for map in data.get("maps", []) %} {{ map }}{% endfor %} - Extensions:{% for script in data.get("extensions", []) %} {{ script }}{% endfor %}" />
    <warning_popup_message message="Version {{ version }}" consoles="MHWESCO" player_slot="0" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="0" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="1" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="2" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="3" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="4" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="5" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="6" />
    <warning_popup_message message="Initialising ship systems...." consoles="MHWESCO" player_slot="7" />
    <gm_instructions title="Instructions">Welcome to the TSN Sandbox Version {{ version }}. ^--Activation---^The activation sequence allows the GM to choose the System and Sector for the players to start.^Once the activation sequence is completed, the main Sandbox menu will appear and the GM can begin their mission. Below is a step-by-step guide to activation: ^- First, ensure all player ships have spawned before activating GM Mode.^- Next, click on Activate GM Mode to begin the Sandbox activation sequence.^- Finally, select the System and Sector where the players will start.^^The GM menus are as follows:^- Bas.: basic interactions, teleporting and deleting entities.^-SPWN.: Spawn AI ships.^-POI: Create points of interest such as waypoints, wrecks, rendezvous points or anomalies.^-Haz.: Spawn hazards such as mines, asteroids and nebulae.^- Int.: Interact with player ships by sending messages, modifying ordnance stores, and causing system damage.^CSTM: custom script features.^AI Off: Click to expand submenu to change NPC AI behaviour.</gm_instructions>
    <!--Test Variables (not required in start block)-->
    <!--End of Test Variables-->
    <set_variable name="tagShipNumber" value="0.0" integer="yes" />
    <set_variable name="CurrentLetter" value="1.0" integer="yes" />
    <set_variable name="System" value="1.0" integer="yes" />
    <!--Random Elements-->
    <set_variable name="Name Assign" value="0.0" integer="yes" />
