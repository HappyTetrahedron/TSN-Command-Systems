{% module clearSidePicker() %}
    <clear_gm_button text="Change" />
    <clear_gm_button text="1" />
    <clear_gm_button text="2 (PLYR)" />
    <clear_gm_button text="3" />
    <clear_gm_button text="4" />
    <clear_gm_button text="5" />
    <clear_gm_button text="6" />
    <clear_gm_button text="7" />
    <clear_gm_button text="8" />
    <clear_gm_button text="9" />
    <clear_gm_button text="10" />
    <clear_gm_button text="11" />
    <clear_gm_button text="12" />
{% endmodule %}
{% for side in range(1, 13) %}
{% set btntx = "2 (PLYR)" if side == 2 else side %}
  <event name="Update_Side_{{ side }}">
    <if_variable name="SideValue" comparator="EQUALS" value="{{ side }}.0" />
    <if_variable name="SidePicker_Side_Shown" comparator="NOT" value="{{ side }}.0" />
    {{ clearSidePicker() }}
    <set_gm_button text="Change" x="245" y="100" h="30" w="60" />
    <set_gm_button text="2 (PLYR)" x="180" y="100" h="30" w="60" />
    <set_variable name="SidePickerOpen" value="0.0" integer="yes" />
  </event>
  <event name="Pick_Side_{{ side }}">
    <if_variable name="SidePickerOpen" comparator="EQUALS" value="1.0" />
    <if_gm_button text="{{ btntx }}" />
    <set_variable name="SideValue" value="{{ side }}.0" integer="yes" />
  </event>
{% endfor %}

<event name="OpenSidePicker">
  <if_variable name="SidePickerOpen" comparator="EQUALS" value="0.0" />
  <if_gm_button text="Change" />
  {{ clearSidePicker() }}
  <set_gm_button text="1" x="180" y="100" h="30" w="20" />
  <set_gm_button text="2 (PLYR)" x="205" y="100" h="30" w="60" />
  <set_gm_button text="3" x="270" y="100" h="30" w="20" />
  <set_gm_button text="4" x="295" y="100" h="30" w="20" />
  <set_gm_button text="5" x="320" y="100" h="30" w="20" />
  <set_gm_button text="6" x="345" y="100" h="30" w="20" />
  <set_gm_button text="7" x="370" y="100" h="30" w="20" />
  <set_gm_button text="8" x="395" y="100" h="30" w="20" />
  <set_gm_button text="9" x="420" y="100" h="30" w="20" />
  <set_gm_button text="10" x="445" y="100" h="30" w="30" />
  <set_gm_button text="11" x="480" y="100" h="30" w="30" />
  <set_gm_button text="12" x="515" y="100" h="30" w="30" />
  <set_variable name="SidePickerOpen" value="1.0" />
</event>

