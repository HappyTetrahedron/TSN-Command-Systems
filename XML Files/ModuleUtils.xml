{% import 'Comms.xml' as _comms %}
{% import 'Utils.xml' as _util %}

{% macro registerPermanentModuleButtons(ship, buttonTexts, identifier) %}
  {# Adds a list of 'permanent' module buttons - buttons that are always available if this module is loaded. #}
  {# Buttons with more complicated conditions for when they should show need to be created and managed by hand. #}
  {% call(ship) _util.createConditionalMenu("Module" + identifier) %}
    {{ _comms.ifMenuVariable(ship, 3) }}
    {% for text in buttonTexts %}
      {{ _comms.button(text, ship) }}
    {% endfor %}
  {% endcall %}
  {% call(ship) _util.destroyConditionalMenu("Module" + identifier) %}
    {{ _comms.ifMenuVariable(ship, 3, "NOT") }}
    {% for text in buttonTexts %}
      {{ _comms.destroybutton(text, ship) }}
    {% endfor %}
  {% endcall %}
{% endmacro %}

{% macro createConditionalModuleButtons(ship, identifier) %}
  {% set caller_cont = caller() %}
  {% call(ship) _util.createConditionalMenu("Module" + identifier) %}
    {{ caller_cont }}
  {% endcall %}
{% endmacro %}

{% macro destroyConditionalModuleButtons(ship, identifier) %}
  {% set caller_cont = caller() %}
  {% call(ship) _util.destroyConditionalMenu("Module" + identifier) %}
    {{ caller_cont }}
  {% endcall %}
{% endmacro %}

{% macro sendCommsButton(text, ship) %}
    {{ _comms.button(text, ship) }}
{% endmacro %}
{% macro clearCommsButton(text, ship) %}
    {{ _comms.destroybutton(text, ship) }}
{% endmacro %}

{% macro ifCommsMenuState(ship, id, comparator="EQUALS") %}
    {{ _comms.ifMenuVariable(ship, id, comparator) }}
{% endmacro %}

{% macro onModuleButtonPressed(text, ship) %}
<event name="Module Button {{ name }} pressed - ship{{ ship.id }}">
    <if_comms_button text="{{ ship.commPrefix }}{{ text }}" />
    {{ caller() }}
</event>
{% endmacro %}