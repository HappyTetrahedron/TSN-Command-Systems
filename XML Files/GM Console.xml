    <set_variable name="Spawn_{{ prefix }}" value="0.0" integer="yes" />
  </event>
  <event name="Reset Pod Number" id_arme="a61108ff-faea-4578-985f-772083c71fba" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
