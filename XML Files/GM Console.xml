    <if_exists name="{{ prefix }} |lifepodNumber|" />
    <set_variable name="Spawn_{{ prefix }}" value="4.0" integer="yes" />
  </event>
  <folder_arme name="Skip Pod Spawn" id_arme="518f7533-d725-4aa6-b4bd-532d1226433d" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618" />
  <event name="Increment Pod Number" id_arme="72d9d21b-afef-44ae-bdaa-5d36bc43be05" parent_id_arme="518f7533-d725-4aa6-b4bd-532d1226433d">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="4.0" />
    <if_variable name="{{ counter }}" comparator="LESS" value="5.0" />
    <set_variable name="{{ counter }}" value="{{ counter }}+1" integer="yes" />
    <set_variable name="Spawn_{{ prefix }}" value="1.0" integer="yes" />
  </event>
