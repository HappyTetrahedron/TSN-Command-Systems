    <set_variable name="Spawn_{{ prefix }}" value="3.0" integer="yes" />
  </event>
  <event name="Lifepod Skip" id_arme="5a236afc-4569-441b-a591-a037a907b1cf" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
