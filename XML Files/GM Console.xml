    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="4.0" />
    <if_variable name="{{ counter }}" comparator="GREATER_EQUAL" value="5.0" />
    <set_variable name="{{ counter }}" value="1.0" integer="yes" />
    <set_variable name="Spawn_{{ prefix }}" value="1.0" integer="yes" />
  </event>
