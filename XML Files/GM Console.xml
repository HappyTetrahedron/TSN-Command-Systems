  <folder_arme name="Action Against Ship7" id_arme="65a2b1eb-27c1-4b17-9b81-372721f78943" parent_id_arme="dcc1e36a-00c8-4b9e-a3ba-cc71c716a850" />
  <event name="Initiate Ship7 Boarding" id_arme="d91abaa8-701c-4994-93df-153c86a0dc03" parent_id_arme="65a2b1eb-27c1-4b17-9b81-372721f78943">
    <if_gm_button text="Boarding Actions\Attack Ship7" />
    <set_variable name="Atk Ship7" value="1.0" />
    <set_variable name="Ship7Attackers" randomIntLow="10" randomIntHigh="30" />
    <warning_popup_message message="Intruder Alert!" consoles="MHWESC" player_slot="6">Intruder Alert!</warning_popup_message>
    <incoming_comms_text from="Ship7" type="STATUS">We have a hull breach! Marines are moving to respond.</incoming_comms_text>
  </event>
  <folder_arme name="Ship Defense" id_arme="0738ce47-48f0-452a-95f4-4492eda26066" parent_id_arme="65a2b1eb-27c1-4b17-9b81-372721f78943" />
  <event name="Ship7 Boarded Percentage" id_arme="667600a9-2b6d-4b88-bfd0-25175fce8086" parent_id_arme="0738ce47-48f0-452a-95f4-4492eda26066">
    <if_variable name="Atk Ship7" comparator="EQUALS" value="1.0" />
    <if_variable name="Ship7Marines" comparator="GREATER" value="0.0" />
    <if_variable name="Ship7Attackers" comparator="GREATER" value="0.0" />
    <set_variable name="Ship7BoardedPercent" randomIntLow="0" randomIntHigh="100" />
    <set_variable name="Ship7BoardedTimer" randomIntLow="2" randomIntHigh="10" />
    <set_variable name="Ship7DamagePercent" randomIntLow="0" randomIntHigh="100" />
    <set_variable name="Atk Ship7" value="2.0" />
  </event>
  <event name="No Marines Aboard" id_arme="c952d112-beeb-4ec6-8666-012c8a1732fc" parent_id_arme="0738ce47-48f0-452a-95f4-4492eda26066">
    <if_variable name="Atk Ship7" comparator="EQUALS" value="1.0" />
    <if_variable name="Ship7Marines" comparator="LESS_EQUAL" value="0.0" />
    <if_variable name="Ship7Attackers" comparator="GREATER" value="0.0" />
    <set_variable name="Ship7Marines" value="0.0" integer="yes" />
    <set_variable name="Ship7Undefended" randomIntLow="10" randomIntHigh="20" />
    <incoming_comms_text from="CHANNEL 7" type="STATUS">Automated defensive systems active.</incoming_comms_text>
    <set_variable name="Atk Ship7" value="10.0" />
  </event>
  <event name="End Attack (No Attackers Aboard)" id_arme="670e99d3-fd7c-430e-b34c-c8239b899c20" parent_id_arme="0738ce47-48f0-452a-95f4-4492eda26066">
    <if_variable name="Atk Ship7" comparator="EQUALS" value="1.0" />
    <if_variable name="Ship7Attackers" comparator="LESS_EQUAL" value="0.0" />
    <set_variable name="Ship7Attackers" value="0.0" integer="yes" />
    <incoming_comms_text from="CHANNEL 7" type="STATUS">Boarders have been successfully repelled.^We have casualties though. We are down to |Ship7Marines| combat ready marines.</incoming_comms_text>
    <set_variable name="Atk Ship7" value="0.0" integer="yes" />
    <set_variable name="Ship7 Marines" value="2.0" />
  </event>
  <event name="Marines &gt; Attackers" id_arme="a83e301d-b1a8-4433-924b-6760cc9d6493" parent_id_arme="0738ce47-48f0-452a-95f4-4492eda26066">
    <if_variable name="Atk Ship7" comparator="EQUALS" value="2.0" />
    <if_variable name="Ship7Marines" comparator="GREATER" value="Ship7Attackers" />
    <set_variable name="Ship7Defense" value="Ship7BoardedPercent+((Ship7Attackers/Ship7Marines)*20)" />
    <set_timer name="Atk Ship7" seconds="Ship7BoardedTimer" />
    <set_variable name="Atk Ship7" value="3.0" />
  </event>
  <event name="Marines &lt; Attackers" id_arme="0b72f775-6736-4448-96f0-997e03ce9321" parent_id_arme="0738ce47-48f0-452a-95f4-4492eda26066">
    <if_variable name="Atk Ship7" comparator="EQUALS" value="2.0" />
    <if_variable name="Ship7Marines" comparator="LESS" value="Ship7Attackers" />
    <set_variable name="Ship7Defense" value="Ship7BoardedPercent-((Ship7Marines/Ship7Attackers)*20)" />
    <set_timer name="Atk Ship7" seconds="Ship7BoardedTimer" />
