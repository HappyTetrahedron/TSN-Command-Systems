    <set_variable name="Ship5BoardedTimer" randomIntLow="2" randomIntHigh="10" />
    <set_variable name="Ship5DamagePercent" randomIntLow="0" randomIntHigh="100" />
    <set_variable name="Atk Ship5" value="2.0" />
  </event>
  <event name="No Marines Aboard" id_arme="775588ed-a262-4695-8978-6601111cbbc1" parent_id_arme="7e83c1f0-1581-43d1-a030-7dc5f8cea38d">
    <if_variable name="Atk Ship5" comparator="EQUALS" value="1.0" />
    <if_variable name="Ship5Marines" comparator="LESS_EQUAL" value="0.0" />
    <if_variable name="Ship5Attackers" comparator="GREATER" value="0.0" />
    <set_variable name="Ship5Marines" value="0.0" integer="yes" />
    <set_variable name="Ship5Undefended" randomIntLow="10" randomIntHigh="20" />
