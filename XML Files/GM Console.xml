    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="1.0" />
    <if_exists name="{{ prefix }} 1" />
    <if_exists name="{{ prefix }} 2" />
    <if_exists name="{{ prefix }} 3" />
    <if_exists name="{{ prefix }} 4" />
    <if_exists name="{{ prefix }} 5" />
