  {% import 'Utils.xml' as util %}

  <folder_arme name="Custom Config" id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837" />
  {%- set defaultOrdnance = {
    "torpedo": 10,
    "mine": 4,
    "nuke": 2,
    "emp": 6,
    "pshock": 6,
    "probe": 3,
    "tag": 2,
    "beacon": 2,
  } -%}
  {%- set ordnanceIdentifiers = {
    "torpedo": "countHoming",
    "mine": "countMine",
    "nuke": "countNuke",
    "emp": "countEMP",
    "pshock": "countShk",
    "probe": "countPro",
    "tag": "countTag",
    "beacon": "countBea",
  } -%}
  {%- set defaultCargo = {
    "marines": 3,
    "engineers": 1,
    "medics": 2,
    "cargos": 0,
    "commsrelays": 1,
    "sensorbuoys": 1,
  } -%}
  {%- set cargoIdentifiers = {
    "marines": "MarineTeams",
    "engineers": "EngineerTeams",
    "medics": "MedicTeams",
    "cargos": "Cargos",
    "commsrelays": "CommsRelays",
    "sensorbuoys": "SensorBuoys",
  } -%}
  {%- set moduleIdentifiers = {
    "cluster": "1",
    "decoy": "2",
    "shieldenhancer": "3",
  } -%}
  {% for ship in util.shipConfigs %}
  <event name="Ship{{ ship.id }} Configuration" id_arme="56643add-a468-4dc1-9549-d6ed1e6757ad" parent_id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837">
    <if_variable name="Custom Config" comparator="EQUALS" value="1.0" />
    <if_variable name="Ship{{ ship.id }} Config" comparator="EQUALS" value="1.0" />
    <if_exists player_slot="{{ ship.slot }}" />
    {% for type, count in g.data.get("ordnance", {}).get("ship" + ship.slot, {}).items() %}
      <set_object_property property="{{ ordnanceIdentifiers[type] }}" value="{{ count }}" player_slot="{{ ship.slot }}" />
    {% endfor %}
    <set_variable name="Ship{{ ship.id }} Config" value="0.0" integer="yes" />
  </event>
{% endfor %}
  <event name="Cargo" id_arme="ed565860-810a-4932-b977-bb8bfdd04316" parent_id_arme="f9dc6a29-7d1b-4399-9daa-0d993badc837">
    <if_variable name="Custom Config" comparator="EQUALS" value="1.0" />
  {% for ship in util.shipConfigs %}
    {% for cargo in util.cargoTypes if not cargo.is_nothing %}
    <set_variable name="Ship{{ ship.id }}{{ cargo.variable }}" value="{{ g.data.get("cargo", {}).get("ship" + ship.id, defaultCargo).get(cargo.api_name, defaultCargo[cargo.api_name]) }}" integer="yes" />
    {% endfor %}
  {% endfor %}
    <set_variable name="Custom Config" value="2.0" integer="yes" />
  </event>