{% macro AutoAIEvents() %}
  {% for id, ai in availableAIs.items() if id < 1000 %}
    {% for i, letter in enumerate(FleetLetters) %}
      <event name="{{ id }} - {{ ai.name }} AI">
        <if_variable name="Auto AI Type" comparator="EQUALS" value="{{ id }}.0" />
        {{ ai.macro(["--"]) }}
      </event>
    {% endfor %}
  {% endfor %}
{% endmacro %}

{% macro ReassignAIEvents() %}
  {% for id, ai in availableAIs.items() %}
    <event name="Reassign {{ ai.name }} AI GM">
      <if_variable name="ReassignLetter" comparator="EQUALS" value="30" />
      <if_variable name="ReassignAI" comparator="EQUALS" value="{{ id }}.0" />
      <if_variable name="ReassignDigits" comparator="NOT" value="1.0" />
      {{ ai.macro(["GM"]) }}
      <set_gm_button text="Reassigning AI" x="230" y="415" h="60" w="150" />
      <set_variable name="ReassignDigits" value="1.0" integer="yes" />
    </event>
    {% for letter in FleetLetters %}
      <event name="Reassign {{ ai.name }} AI {{ letter }}">
        <if_variable name="ReassignLetter" comparator="EQUALS" value="{{ loop.index }}" />
        <if_variable name="ReassignAI" comparator="EQUALS" value="{{ id }}.0" />
        <if_variable name="ReassignDigits" comparator="NOT" value="1.0" />
        {{ ai.macro([
          letter + "0|reassignNumber0|",
          letter + "|reassignNumber2|",
          letter + "|reassignNumber4|",
          letter + "|reassignNumber8|",
          letter + "|reassignNumber6|",
        ]) }}
        <set_gm_button text="Reassigning AI" x="230" y="415" h="60" w="150" />
        <set_variable name="ReassignDigits" value="1.0" integer="yes" />
      </event>
    {% endfor %}
  {% endfor %}
{% endmacro %}


