{% 
  set availableAIs = {
    "Default": {
      "macro": ConfigureDefaultAI,
      "id": 2
    }
  }
%}

{% macro ConfigureDefaultAI(names) %}
  {% for name in names %}
    <clear_ai name="{{ name }}" />
    <add_ai type="TRY_TO_BECOME_LEADER" name="{{ name }}" />
    <add_ai type="CHASE_PLAYER" name="{{ name }}" />
    <add_ai type="CHASE_STATION" value1="1000" name="{{ name }}" />
    <add_ai type="CHASE_AI_SHIP" value1="3000" value2="500" name="{{ name }}" />
    <add_ai type="CHASE_PLAYER" value1="3000" value2="500" name="{{ name }}" />
    <add_ai type="CHASE_ANGER" name="{{ name }}" />
    <add_ai type="LEADER_LEADS" name="{{ name }}" />
    <add_ai type="FOLLOW_LEADER" name="{{ name }}" />
    <add_ai type="LAUNCH_FIGHTERS" value1="8000" name="{{ name }}" />
  {% endfor %}
{% endmacro %}


{% macro ReassignAI() %}
  {% for name, ai in availableAIs.items %}
    {% for i, letter in enumerate(FleetLetters) %}
      <event name="{{ name }} Reassign {{ letter }}">
        <if_variable name="ReassignLetter" comparator="EQUALS" value="{{ i }}" />
        <if_variable name="ReassignAI" comparator="EQUALS" value="{{ ai.id }}.0" />
        <if_variable name="ReassignDigits" comparator="NOT" value="1.0" />
        {{ ai.macro([
          letter + "0|reassignNumber0|",
          letter + "|reassignNumber2|",
          letter + "|reassignNumber4|",
          letter + "|reassignNumber8|",
          letter + "|reassignNumber6|",
        ]) }
        <set_gm_button text="Reassigning AI" x="230" y="415" h="60" w="150" />
        <set_variable name="ReassignDigits" value="1.0" integer="yes" />}
      </event>
    {% endfor %}
  {% endfor %}
{% endmacro %}


