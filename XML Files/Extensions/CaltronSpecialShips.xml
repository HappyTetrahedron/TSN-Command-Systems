{% call destroy.onDestroy("CaltronShips") %}
  {% for npc in caltronships %}
  <destroy name="{{ npc.name }}" />
  {% endfor %}
{% endcall %}

{% macro caltronSpecialAI(name) %}
    <add_ai type="SPCL_AI" name="{{ name }}" />
    <add_ai type="CHASE_PLAYER" name="{{ name }}" />
    <add_ai type="CHASE_STATION" value1="1000" name="{{ name }}" />
    <add_ai type="CHASE_AI_SHIP" value1="3000" value2="500" name="{{ name }}" />
    <add_ai type="CHASE_PLAYER" value1="5000" value2="500" name="{{ name }}" />
    <add_ai type="CHASE_ANGER" name="{{ name }}" />
    <add_ai type="LAUNCH_FIGHTERS" value1="2000" name="{{ name }}" />
    <set_special name="{{ name }}" ship="1" /> <!-- overpowered -->
{% endmacro %}


  {% for npc in caltronships %}
  {% call spawn.spawn(const.spawnFactions.Caltron.key, "Replica", "+" + npc.name) %}
    <create type="enemy" use_gm_position="" angle="0" name="{{ npc.name }}" hullID="{{ npc.hull }}" sideValue="SideValue" fleetnumber="-1" />

    <set_object_property property="surrenderChance" value="0" name="{{ npc.name }}" />
    <clear_ai name="{{ npc.name }}" />
    {{ caltronSpecialAI(npc.name) }}
    {% for spec in npc.specials %}
    <set_special name="{{ npc.name }}" ability="{{ spec }}" />
    {% endfor %}
    <set_ship_text name="{{ npc.name }}" desc="{{ npc.desc }}" race="{{ npc.race }}" class="{{ npc.class }}"
      scan_desc="{{ npc.scan }}" />
  {% endcall %}
  {% endfor %}
