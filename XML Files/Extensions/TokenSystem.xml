{# GM tool to give the player virtual "tokens", a counter for which gets displayed on the map. #}

{% import 'Utils.xml' as util %}
{% import 'Start.xml' as start %}
{% import 'GM Menus.xml' as menu %}

{% call start.onStart("TokenSystem") %}
    <set_variable name="TokenSysT" value="0.0" integer="yes" />
    <set_variable name="TokenSysS" value="0.0" integer="yes" />
{% endcall %}

{% call menu.onButtonClick("AddToken", menu.main.base) %}
  <set_variable name="TokenSysT" value="TokenSysT + 1" integer="yes" />
  {% for ship in util.shipConfigs %}
    <warning_popup_message message="&gt; You receive a token &lt;" consoles="MSC" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}

{% call menu.onButtonClick("RmToken", menu.main.base) %}
  <set_variable name="TokenSysT" value="TokenSysT - 1" integer="yes" />
  {% for ship in util.shipConfigs %}
    <warning_popup_message message="&gt; You spent a token &lt;" consoles="MSC" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}

<event name="UpdateTokenCounter">
  <if_variable name="TokenSysT" comparator="NOT" value="TokenSysS" />
  <destroy name="Tokens: |TokenSysS|" />
  <create type="genericMesh" x="0.0" y="0.0" z="0.0" name="Tokens: |TokenSysT|" meshFileName="dat\TSN\USFP\marker.dxs" textureFileName="dat\TSN\USFP\marker.png" colorRed="1.0" colorGreen="1.0" colorBlue="1.0" />
  <set_variable name="TokenSysS" value="TokenSysT" integer="yes" />
</event>
