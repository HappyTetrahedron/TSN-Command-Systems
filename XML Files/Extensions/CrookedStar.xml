{# Adds the notorious pirate ship Crooked Star #}
{% import 'Core/Spawn.xml' as spawn %}
{% import 'Constants.xml' as const %}

{% call spawn.spawn(const.spawnFactions.Pirate.key, "Skull Pirates", "+Crooked Star") %}
  <create type="enemy" use_gm_position="" angle="0" name="Crooked Star" hullID="7107" sideValue="SideValue" fleetnumber="-1" />
  <clear_ai name="Crooked Star" />
  <set_object_property property="surrenderChance" value="0" name="Crooked Star" />
  <add_ai type="SPCL_AI" name="Crooked Star" />
  <add_ai type="TRY_TO_BECOME_LEADER" name="Crooked Star" />
  <add_ai type="CHASE_PLAYER" name="Crooked Star" />
  <add_ai type="CHASE_STATION" value1="1000" name="Crooked Star" />
  <add_ai type="CHASE_AI_SHIP" value1="3000" value2="500" name="Crooked Star" />
  <add_ai type="CHASE_PLAYER" value1="3000" value2="500" name="Crooked Star" />
  <add_ai type="CHASE_ANGER" name="Crooked Star" />
  <add_ai type="LEADER_LEADS" name="Crooked Star" />
  <add_ai type="FOLLOW_LEADER" name="Crooked Star" />
  <set_special name="Crooked Star" clear="yes" ability="Stealth" />
  <set_special name="Crooked Star" clear="yes" ability="LowVis" />
  <set_special name="Crooked Star" clear="yes" ability="Cloak" />
  <set_special name="Crooked Star" ability="HET" />
  <set_special name="Crooked Star" ability="Warp" />
  <set_special name="Crooked Star" clear="yes" ability="Teleport" />
  <set_special name="Crooked Star" ability="Tractor" />
  <set_special name="Crooked Star" clear="yes" ability="Drones" />
  <set_special name="Crooked Star" clear="yes" ability="AntiMine" />
  <set_special name="Crooked Star" clear="yes" ability="AntiTorp" />
  <set_special name="Crooked Star" ability="ShldDrain" />
  <set_special name="Crooked Star" clear="yes" ability="ShldVamp" />
  <set_special name="Crooked Star" clear="yes" ability="TeleBack" />
  <set_special name="Crooked Star" ability="ShldReset" />
{% endcall %}