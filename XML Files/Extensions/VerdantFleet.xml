      <add_ai type="CHASE_STATION" value1="10000" name="{{ name }}" />
      <add_ai type="CHASE_AI_SHIP" value1="10000" value2="10000" name="{{ name }}" />
      <add_ai type="CHASE_PLAYER" value1="10000" value2="10000" name="{{ name }}" />
      <add_ai type="CHASE_ANGER" name="{{ name }}" />
      <add_ai type="LEADER_LEADS" name="{{ name }}" />
