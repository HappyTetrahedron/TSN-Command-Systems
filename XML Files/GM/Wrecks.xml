{% import 'GM Menus.xml' as menu %}
{% import 'Utils.xml' as util %}


{% set factions = util.spawnFactions %}

{% for faction in factions.values() %}
  {# Not all factions have wrecks so far #}
  {% if faction.name not in ["Neutral"] %}
    {{ menu.addEphemeralSubmenu("Wrecks " + faction.name, "Wrecks") }}
  {% endif %}
{% endfor %}

{{ menu.addButtonExpandMenu("Wrecks", menu.main.poi, x=190, y=115, h=30, w=70, rows=6) }}


{% macro spawnWreck(faction, name) %}
  {% set outercaller = caller %}
  {% call menu.onMenuClick(name, "Wrecks " + faction.name) %}
    {{ outercaller() }}
    <set_variable name="Auto AI Type" value="402.0" integer="yes" />
    <set_variable name="Name Assign" value="1.0" integer="yes" />
    <set_ship_text name="--" desc="Systems offline" scan_desc="No life signs. Trace energy signatures detected. " />
  {% endcall %}
{% endmacro %}

