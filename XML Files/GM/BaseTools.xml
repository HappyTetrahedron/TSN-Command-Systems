{% import 'GM Menus.xml' as menu %}
{% import 'Utils.xml' as util %}
{% import 'Picker.xml' as picker %}

{% call menu.onButtonClick("PlyrToGM", menu.main.base) %}
  {% for ship in util.shipConfigs %}
    <set_to_gm_position player_slot="{{ ship.slot }}" distance="300" angle="45" />
    <set_object_property property="angle" value="0.785398163" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}

{% call menu.onButtonClick("SlctdToGm", menu.main.base) %}
    <set_to_gm_position use_gm_selection=" " distance="0" angle="0.0" />
{% endcall %}

{% call menu.onButtonClick("DelTerrain", menu.main.base) %}
    <destroy_near type="asteroids" radius="5000" use_gm_position="" />
    <destroy_near type="mines" radius="5000" use_gm_position="" />
    <destroy_near type="nebulas" radius="5000" use_gm_position="" />
{% endcall %}

{% call menu.onButtonClick("DelAllMines", menu.main.base) %}
    <destroy_near type="mines" radius="80000" centerX="50000" centerY="0" centerZ="50000" />
{% endcall %}

{% call menu.onButtonClick("DelSelected", menu.main.base) %}
    <destroy use_gm_selection="" />
{% endcall %}

{% set sides = range(1, 14)|list %}
{% do sides.__setitem__(1, "2 Dflt") %}
{% call(choice) picker.Picker("PS", "CHNG", sides, "Player Side:", 0, 100, 68, track="playerSide") %}
  {% set side = 2 if choice == "2 Dflt" else choice|int %}
  {% for ship in util.shipConfigs %}
    <set_side_value value="{{ side }}" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}

{% call(isCreate) menu.addStatementToMenu("PS", menu.main.base) %}
  <set_variable name="PSPicker_Should_Show" value="{{ 1 if isCreate else 0 }}" integer="yes" />
{% endcall %}

{{ menu.addEphemeralSubmenu("SectorSide", menu.main.base) }}
{{ menu.addEphemeralSubmenu("SystemSide", menu.main.base) }}

{% call menu.onMenuClick("Default", "SystemSide") %}
    <set_variable name="systemSideOverride" value="0.0" integer="yes" />
    <set_variable name="System Settings" value="1.0" integer="yes" />
{% endcall %}
{% call menu.onMenuClick("Default", "SectorSide") %}
    <set_variable name="sectorSideOverride" value="1.0" integer="yes" />
    <set_variable name="System Settings" value="2.0" integer="yes" />
{% endcall %}

{% for side in range(1, 10) %}
    {% call menu.onMenuClick("Side " + side|string, "SystemSide") %}
        <set_variable name="systemSideOverride" value="{{ side }}.0" integer="yes" />
        <set_variable name="System Settings" value="1.0" integer="yes" />
    {% endcall %}
    {% call menu.onMenuClick("Side " + side|string, "SectorSide") %}
        <set_variable name="sectorSideOverride" value="{{ side }}.0" integer="yes" />
        <set_variable name="System Settings" value="2.0" integer="yes" />
    {% endcall %}

{% endfor %}

{{ menu.addEphemeralSubmenu("End Mission", menu.main.base) }}
  {% call menu.onMenuClick("Shut down ships", "End Mission") %}
    <warning_popup_message message="Ship systems shutting down" consoles="MHWESC" />
    <set_variable name="Mission End" value="1.0" />
    <set_timer name="Mission End" seconds="3" />
  {% endcall %}
  {% call menu.onMenuClick("Engage Autopilot", "End Mission") %}
    <warning_popup_message message="Transferring control to automated systems" consoles="MHWESC" />
    <set_variable name="Mission End" value="1.0" />
    <set_timer name="Mission End" seconds="3" />
  {% endcall %}
  {% call menu.onMenuClick("Cancel", "End Mission") %}
  {% endcall %}
