{% include 'NewSystems/SystemTemplate.jinja' %}
{% import 'NewSystems/SystemUtils.jinja' as sysutil %}
{% import 'Utils.xml' as util %}


{% call sysutil.runOnSystemLoad(g.system) %}
  <set_timer name="Vrae_Pulsar_Timer" seconds="1" />
  <set_variable name="Vrae_Pulsar_InRange" value="0.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.system, [2,3,4,6,7,8,10,11,12]) %}
  <if_variable name="Vrae_Pulsar_InRange" comparator="NOT" value="1.0" />
  <warning_popup_message message="Warning: Intense Static Energy Pulses Detected" consoles="MHWESCO">Warning: Intense Static Energy Pulses</warning_popup_message>
  <set_variable name="Vrae_Pulsar_InRange" value="1.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.system, [1,5,9]) %}
  <if_variable name="Vrae_Pulsar_InRange" comparator="EQUALS" value="1.0" />
  <warning_popup_message message="Clear: Static Energy Nominal" consoles="MHWESCO">Static Energy Nominal</warning_popup_message>
  <set_variable name="Vrae_Pulsar_InRange" value="0.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.system, [2,3,4,6,8,10,11,12]) %}
  <if_timer_finished name="Vrae_Pulsar_Timer" />
  {% for ship in util.shipConfigs %}
    <addto_object_property value="20" property="energy" player_slot="{{ ship.slot }}"  />
  {% endfor %}
  <set_timer name="Vrae_Pulsar_Timer" seconds="1" />
{% endcall %}

{% call sysutil.runIfInSector(g.system, [7]) %}
  <if_timer_finished name="Vrae_Pulsar_Timer" />
  {% for ship in util.shipConfigs %}
    <addto_object_property value="50" property="energy" player_slot="{{ ship.slot }}"  />
  {% endfor %}
  <set_timer name="Vrae_Pulsar_Timer" seconds="1" />
{% endcall %}