{% call createPickuppable("*|BBNumber|*", "Blackbox", "BBNumber") %}
  <create type="genericMesh" use_gm_position="" name="*|BBNumber|*" meshFileName="dat\mine.dxs" textureFileName="dat\cargo_vessel_glow.png" colorRed="0.4" colorGreen="0.4" colorBlue="0.4" />
  <warning_popup_message message="Blackbox Detected" consoles="MCF">Data recorder detected.^Downloading data......</warning_popup_message>
  <set_object_property property="rollDelta" value="2.0" name="*|BBNumber|*" />
  <set_object_property property="angle" value="0.5" name="*|BBNumber|*" />
  <set_object_property property="pushRadius" value="10.0" name="*|BBNumber|*" />
  <set_object_property property="artScale" value="0.02" name="*|BBNumber|*" />
  <set_object_property property="positionY" value="2.5" name="*|BBNumber|*" />
  {% for ship in util.ShipConfigs %}
    <set_variable name="Black Box |BBNumber| {{ ship.shuttle }} Retrieves" value="0.0" integer="yes" />
  {% endfor %}
{% endcall %}

{# Shuttle Resupply #}
{{ menu.addDismissableSubmenu("Shuttle Resup", menu.main.interaction) }}

{% for ship in util.shipConfigs %}
  {% call menu.onMenuClick(ship.shuttle, "Shuttle Resup") %}
    <create type="station" use_gm_position="" name="{{ ship.shuttle }} Pickup" hullID="1058" sideValue="2" />
    <set_object_property property="canBuild" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresHoming" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresNuke" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresMine" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresEMP" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresPShock" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresTag" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresBeacon" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_object_property property="missileStoresProbe" value="0" name="{{ ship.shuttle }} Pickup" />
    <set_player_station_carried name="{{ ship.shuttle }} Pickup" raceKeys="TSN" hullKeys="TSN Shuttle shuttle" singleSeatName="{{ ship.shuttle }}" />
    <set_variable name="{{ ship.shuttle }} Status" value="1.0" integer="yes" />
  {% endcall %}
{% endfor %}
