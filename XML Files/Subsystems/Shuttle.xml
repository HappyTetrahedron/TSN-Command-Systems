  <set_object_property property="rollDelta" value="-0.2" name="Life Pod |lifepodNumber|" />
  <set_object_property property="pushRadius" value="20.0" name="Life Pod |lifepodNumber|" />
  <set_object_property property="angleDelta" value="0.05" name="Life Pod |lifepodNumber|" />
  <addto_object_property value="10.0" property="positionY" name="Life Pod |lifepodNumber|" />
  <set_ship_text name="Life Pod |lifepodNumber|" desc="Life pod" scan_desc="Life signs detected." hailtext="Automated Distress Signal detected." />
{% endcall %}
{% call createPickuppable("Weapons Crate |crateNumber|", "WeaponCrate", "crateNumber") %}
