{% import 'Constants.xml' as const %}
{% import 'Tools/Conditions.xml' as cond %}
{% import 'Core/Comms.xml' as comms %}
{% import 'Core/Spawn.xml' as spawn %}
{% import 'Core/PlayerTracking.xml' as tracking %}

{% for sup in const.supplyShips %}
  {# Ship state tracking #}
  {% call(ship) tracking.onSpawn("MaxOrdnance") %}
    {% for ordnance, property in const.ordnanceIdentifiers.items() %}
      <get_object_property property="{{ property }}" player_slot="{{ ship.slot }}" variable="Ship{{ ship.id }}{{ ordnance }}Max" />
    {% endfor %}
  {% endcall %}

  {# Spawn logic #}
  {% call spawn.spawn(spawn.factions.TSN.key, "TSN Fleets", sup.name + " Supply Fleet", autoAI=203, nameAssign=True, randomDir=True, fleetSettings=True) %}
    <create type="enemy" use_gm_position="" name="{{ sup.name }}" hullID="1605" sideValue="SideValue" fleetnumber="Fleetnumber" />
    <create type="enemy" use_gm_position="" name="--" hullID="1500" sideValue="SideValue" fleetnumber="Fleetnumber" />
    <create type="enemy" use_gm_position="" name="--" hullID="1500" sideValue="SideValue" fleetnumber="Fleetnumber" />
  {% endcall %}
  {% call spawn.spawn(spawn.factions.TSN.key, "TSN Ships", sup.name + " Supply Ship") %}
    <create type="enemy" use_gm_position="" name="{{ sup.name }}" hullID="1605" sideValue="SideValue" fleetnumber="Fleetnumber" />
    <set_object_property property="shieldMaxStateFront" value="200" name="{{ sup.name }}" />
    <set_object_property property="shieldMaxStateBack" value="200" name="{{ sup.name }}" />
    <set_object_property property="shieldStateFront" value="200" name="{{ sup.name }}" />
    <set_object_property property="shieldStateBack" value="200" name="{{ sup.name }}" />
  {% endcall %}

  {# Ship initializiation #}
  <event name="{{ sup.name }} Inactive" id_arme="88ba7625-98d4-42ed-8c78-d2574d6ee66a" parent_id_arme="09e6e2df-4395-454f-a7c8-ebd5613c7ecc">
    <if_not_exists name="{{ sup.name }}" />
    <set_variable name="{{ sup.name }} Supplies" value="0.0" integer="yes" />
  </event>
  <event name="{{ sup.name }} Active" id_arme="4f73b7d3-5ecd-470e-ae41-1483520e1218" parent_id_arme="09e6e2df-4395-454f-a7c8-ebd5613c7ecc">
    <if_variable name="{{ sup.name }} Supplies" comparator="EQUALS" value="0.0" />
    <if_exists name="{{ sup.name }}" />
    {% for ship in const.shipConfigs %}
    <set_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" value="0.0" integer="yes" />
    {% endfor %}
    <!--Stores and Building-->
    {% for ordnance in const.ordnanceIdentifiers.keys() %}
      <set_variable name="{{ sup.name }}{{ ordnance }}" value="{{ sup.stores[ordnance] }}.0" integer="yes" />
      <set_variable name="{{ sup.name }}build{{ ordnance }}" value="0.0" integer="yes" />
      <set_timer name="{{ sup.name }}build{{ ordnance }}" seconds="2" />
    {% endfor %}
    <!--General Stats-->
    <set_ship_text name="{{ sup.name }}" desc="Auxiliary supply ship for TSN combat vessels" scan_desc="Max. Supplies: {% for ord in const.ordnance.keys() %}{{ sup.stores[ord]}} {{ ord|title }}{{ '.' if loop.last else ','}}{% endfor %}" hailtext="Wrenches on standby!" />
    <incoming_comms_text from="{{ sup.name }}" sideValue="playerSide" type="FRIEND">Supply Ship {{ sup.name }} is standing ready to resupply TSN ships.^Stores:{% for ord in const.ordnance.keys() %}^{{ ord|title }}s: |{{ sup.name }}{{ ord }}|{% endfor %}</incoming_comms_text>
    <set_object_property property="topSpeed" value="0.8" name="{{ sup.name }}" />
    <clear_ai name="{{ sup.name }}" />
    <add_ai type="DIR_THROTTLE" value1="0" value2="1.0" name="{{ sup.name }}" />
    <add_ai type="FOLLOW_COMMS_ORDERS" name="{{ sup.name }}" />
    <set_variable name="{{ sup.name }} Supplies" value="2.0" integer="yes" />
  </event>

  {# Ordnance Manufacturing #}
  {% for ordnance in const.ordnanceIdentifiers.keys() %}
    <event name="Track {{ ordnance }}">
      <if_variable name="{{ sup.name }} Supplies" comparator="EQUALS" value="2.0" />
      <if_variable name="{{ sup.name }}{{ ordnance }}" comparator="LESS_EQUAL" value="1.0" />
      <if_variable name="{{ sup.name }}build{{ ordnance }}" comparator="EQUALS" value="0.0" />
      <set_variable name="{{ sup.name }}build{{ ordnance }}" value="1.0" integer="yes" />
      <incoming_comms_text from="{{ sup.name }}" sideValue="playerSide" type="FRIEND">Our {{ ordnance|title }} load is low. We have started the manufacturing process and are now converting raw materials to increase our supplies. </incoming_comms_text>
      <set_timer name="{{ sup.name }}build{{ ordnance }}" seconds="2" />
    </event>
    <event name="Build {{ ordnance }}">
      <if_variable name="{{ sup.name }}build{{ ordnance }}" comparator="EQUALS" value="1.0" />
      <if_variable name="{{ sup.name }}{{ ordnance }}" comparator="NOT" value="20.0" />
      <if_timer_finished name="{{ sup.name }}build{{ ordnance }}" />
      <set_variable name="{{ sup.name }}{{ ordnance }}" value="{{ sup.name }}{{ ordnance }}+1" integer="yes" />
      <set_timer name="{{ sup.name }}build{{ ordnance }}" seconds="20" />
    </event>
    <event name="{{ ordnance }} Full">
      <if_variable name="{{ sup.name }}build{{ ordnance }}" comparator="EQUALS" value="1.0" />
      <if_variable name="{{ sup.name }}{{ ordnance }}" comparator="EQUALS" value="20.0" />
      <incoming_comms_text from="{{ sup.name }}" sideValue="playerSide" type="FRIEND">Our {{ ordnance|title }} stores are at full capacity.</incoming_comms_text>
      <set_variable name="{{ sup.name }}build{{ ordnance }}" value="0.0" integer="yes" />
    </event>
  {% endfor %}

  {# Ship Proximity Tracking #}
  {% for ship in const.shipConfigs %}
    <event name="Ship{{ ship.id }} In Range">
      <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="EQUALS" value="0.0" />
      <if_distance player_slot1="{{ ship.slot }}" name2="{{ sup.name }}" comparator="LESS" value="1000.0" />
      <if_object_property property="shieldsOn" player_slot="{{ ship.slot }}" comparator="EQUALS" value="0" />
      <incoming_comms_text from="CHANNEL {{ ship.id }}" sideValue="playerSide" type="STATUS">{{ sup.name }} systems locked.^Setting up system interface....</incoming_comms_text>
      <set_timer name="Resupply Ship{{ ship.id }}" seconds="10" />
      <set_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" value="1.0" integer="yes" />
    </event>
    <event name="Ship{{ ship.id }} Ready">
      <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="EQUALS" value="1.0" />
      <if_distance player_slot1="{{ ship.slot }}" name2="{{ sup.name }}" comparator="LESS" value="1000.0" />
      <if_timer_finished name="Resupply Ship{{ ship.id }}" />
      <incoming_comms_text from="CHANNEL {{ ship.id }}" sideValue="playerSide" type="STATUS">System interface complete.^Awaiting resupply request.^Remain within 1000 of {{ sup.name }}, with shields offline, to initiate supply transfer.</incoming_comms_text>
      <set_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" value="2.0" integer="yes" />
    </event>
    <event name="Ship{{ ship.id }} Out of Range">
      <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="GREATER_EQUAL" value="1.0" />
      <if_distance player_slot1="{{ ship.slot }}" name2="{{ sup.name }}" comparator="GREATER" value="1000.0" />
      <incoming_comms_text from="CHANNEL {{ ship.id }}" sideValue="playerSide" type="STATUS">Interface disconnected: Range increased beyond 1000.</incoming_comms_text>
      <set_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" value="0.0" integer="yes" />
    </event>
    <event name="Ship{{ ship.id }} Shields Up">
      <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="GREATER_EQUAL" value="1.0" />
      <if_object_property property="shieldsOn" player_slot="{{ ship.slot }}" comparator="EQUALS" value="1" />
      <incoming_comms_text from="CHANNEL {{ ship.id }}" sideValue="playerSide" type="STATUS">Interface disconnected: Shields raised.</incoming_comms_text>
      <set_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" value="0.0" integer="yes" />
    </event>
  {% endfor %}

  {# Resupply Procedures #}
  {% for ship in const.shipConfigs %}
    {% for ordnance, property in const.ordnanceIdentifiers.items() %}
      <event name="Resupply {{ ordnance }}">
        <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="EQUALS" value="3.0" />
        <if_variable name="{{ sup.name }}{{ ordnance }}" comparator="GREATER" value="1.0" />
        <if_timer_finished name="Resupply Ship{{ ship.id }}" />
        <if_object_property property="shieldsOn" player_slot="{{ ship.slot }}" comparator="EQUALS" value="0.0" />
        <if_object_property property="{{ property }}" player_slot="{{ ship.slot }}" comparator="LESS" value="Ship{{ ship.id }}{{ ordnance }}Max" />
        <set_variable name="{{ sup.name }}{{ ordnance }}" value="{{ sup.name }}{{ ordnance }}-1" integer="yes" />
        <set_ship_text name="{{ sup.name }}" hailtext="Wrenches on standby!^Stores:{% for ord in const.ordnance.keys() %}^{{ ord|title }}s: |{{ sup.name }}{{ ord }}|{% endfor %}" />
        <addto_object_property value="1.0" property="{{ property }}" player_slot="{{ ship.slot }}" />
        <set_timer name="Resupply Ship{{ ship.id }}" seconds="2" />
      </event>


    {% endfor %}
  {% endfor %}

  {# Comms buttons #}
  {% call(ship, isCreate) cond.runIfConditionPerShip("Resupply" + sup.name) %}
    {% if isCreate %}
      <if_exists player_slot="{{ ship.slot }}" />
    {% endif %}
    <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="{{ "EQUALS" if isCreate else "NOT" }}" value="2.0" />
    {% if isCreate %}
      {{ comms.button("Resupply from " + sup.name, ship) }}
    {% else %}
      {{ comms.destroybutton("Resupply from " + sup.name, ship) }}
    {% endif %}
  {% endcall %}

  {% call(ship) comms.onButtonPress("Resupply from " + sup.name) %}
      <if_exists player_slot="{{ ship.slot }}" />
      <if_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" comparator="EQUALS" value="2.0" />
      <incoming_comms_text from="{{ sup.name }}" sideValue="playerSide" type="FRIEND">Request Received - beginning resupply.^Maintain distance 1000 from {{ sup.name }}, with shields offline.^Remaining Stores:{% for ord in const.ordnance.keys() %}^{{ ord|title }}s: |{{ sup.name }}{{ ord }}|{% endfor %}</incoming_comms_text>
      <set_variable name="{{ sup.name }}toShip{{ ship.id }}Resupply" value="3.0" integer="yes" />
  {% endcall %}

{# End of loop over supply ships #}
{% endfor %}