{% macro Picker(prefix, switchBtn, pickBtns, label, initialChoice, startX, startY) %}
<event name="Initialize Picker {{ prefix }}">
  <if_variable name="{{ prefix }}Picker_Choice" comparator="EQUALS" value="0.0" />
  <set_variable name="{{ prefix }}Picker_Choice" value="{{ initialChoice }}.0" integer="yes" />
</event>
<event name="Open Picker {{ prefix }}">
  <if_variable name="{{ prefix }}PickerOpen" comparator="EQUALS" value="0.0" />
  <if_gm_button text="{{ prefix }}   {{ switchBtn }}" />

  <clear_gm_button text="{{ prefix }}   {{ switchBtn }}" />

  {% for p in pickBtns %}
  <clear_gm_button text="PIK{{ prefix }}   {{p}}" />
  <set_gm_button text="{{ prefix }}   {{p}}" x="{{ startX + 80 + loop.index0 * 25 }}" y="{{ startY }}" h="30" w="20" />
  {% endfor %}
  <set_variable name="{{ prefix }}PickerOpen" value="1.0" integer="yes" />
</event>

<event name="Cleanup Picker {{ prefix }}">
  <if_variable name="{{ prefix }}Picker_Should_Show" comparator="EQUALS" value="0.0" />
  <if_variable name="{{ prefix }}Picker_Shown" comparator="EQUALS" value="1.0" />
  {% for p in pickBtns %}
  <clear_gm_button text="{{ prefix }}   {{p}}" />
  <clear_gm_button text="PIK{{ prefix }}   {{p}}" />
  {% endfor %}
  <clear_gm_button text="{{ prefix }}   {{ switchBtn }}" />
  <clear_gm_button text="{{ label }}" />

  <set_variable name="{{ prefix }}Picker_Shown" value="0.0" integer="yes" />
  <set_variable name="{{ prefix }}Picker_Choice_Shown" integer="yes" value="0.0" />
</event>

{% for btn in pickBtns %}
  <event name="Picker {{ prefix }} Restore {{ btn }}">
    <if_variable name="{{ prefix }}PickerOpen" comparator="EQUALS" value="0.0" />
    <if_variable name="{{ prefix }}Picker_Choice" comparator="EQUALS" value="{{ loop.index }}.0" />
    <if_variable name="{{ prefix }}Picker_Choice_Shown" comparator="NOT" value="{{ loop.index }}.0" />
    <if_variable name="{{ prefix }}Picker_Should_Show" comparator="EQUALS" value="1.0" />

    <set_gm_button text="{{ label }}" x="{{ startX }}" y="{{ startY }}" h="30" w="80" />
    <set_gm_button text="{{ prefix }}   {{ switchBtn }}" x="{{ startX + 140 }}" y="{{ startY }}" h="30" w="60" />

    {% for p in pickBtns %}
    <clear_gm_button text="{{ prefix }}   {{p}}" />
    <clear_gm_button text="PIK{{ prefix }}   {{p}}" />
    {% endfor %}

    <set_gm_button text="PIK{{ prefix }}   {{ btn }}" x="{{ startX + 80 }}" y="{{ startY }}" h="30" w="60" />
    <set_variable name="{{ prefix }}Picker_Choice_Shown" value="{{ loop.index }}.0" integer="yes" />
    <set_variable name="{{ prefix }}Picker_Shown" value="1.0" integer="yes" />
  </event>
  <event name="Picker {{ prefix }} OnClick {{ btn }}">
    <if_variable name="{{ prefix }}PickerOpen" comparator="EQUALS" value="1.0" />
    <if_gm_button text="{{ prefix }}   {{ btn }}" />
    <set_variable name="{{ prefix }}Picker_Choice" value="{{ loop.index }}.0" integer="yes" />
    <set_variable name="{{ prefix }}PickerOpen" value="0.0" integer="yes" />
    {{ caller(btn) }}
  </event>
{% endfor %}
{% endmacro %}

{% macro PickerStateless(prefix, switchBtn, pickBtns, startX, startY) %}
<event name="Show Picker {{ prefix }}">
  <if_variable name="{{ prefix }}Picker_Should_Show" comparator="EQUALS" value="1.0" />
  <if_variable name="{{ prefix }}Picker_Shown" comparator="NOT" value="1.0" />
  <set_gm_button text="{{ prefix }}   {{ switchBtn }}" x="{{ startX }}" y="{{ startY }}" h="30" w="80" />
  <set_variable name="{{ prefix }}Picker_Shown" value="1.0" integer="yes" />
</event>
<event name="Open Picker {{ prefix }}">
  <if_variable name="{{ prefix }}PickerOpen" comparator="EQUALS" value="0.0" />
  <if_gm_button text="{{ prefix }}   {{ switchBtn }}" />
  {% for p in pickBtns %}
  <set_gm_button text="{{ prefix }}   {{p}}" x="{{ startX + 80 + loop.index0 * 25 }}" y="{{ startY }}" h="30" w="20" />
  {% endfor %}
  <set_gm_button text="{{ prefix }}   Cancel" x="{{ startX + 80 + pickBtns|length * 25 }}" y="{{ startY }}" h="30" w="30" />
</event>
{% for btn in pickBtns %}
  <event name="Picker {{ prefix }} OnClick {{ btn }}">
    <if_gm_button text="{{ prefix }}   {{ btn }}" />
    {{ caller(btn) }}
    {% for btn in pickBtns %}
    <clear_gm_button text="{{ prefix }}   {{btn}}" />
    {% endfor %}
    <clear_gm_button text="{{ prefix }}   Cancel" />
  </event>
{% endfor %}
  <event name="Picker {{ prefix }} Cancel">
    <if_gm_button text="{{ prefix }}   Cancel" />
    {% for btn in pickBtns %}
    <clear_gm_button text="{{ prefix }}   {{btn}}" />
    {% endfor %}
    <clear_gm_button text="{{ prefix }}   Cancel" />
  </event>

<event name="Cleanup Picker {{ prefix }}">
  <if_variable name="{{ prefix }}Picker_Should_Show" comparator="EQUALS" value="0.0" />
  <if_variable name="{{ prefix }}Picker_Shown" comparator="EQUALS" value="1.0" />
  {% for p in pickBtns %}
    <clear_gm_button text="{{ prefix }}   {{p}}" />
  {% endfor %}
  <clear_gm_button text="{{ prefix }}   Cancel" />
  <clear_gm_button text="{{ prefix }}   {{ switchBtn }}" />
  <set_variable name="{{ prefix }}Picker_Shown" value="0.0" integer="yes" />
</event>
{% endmacro %}