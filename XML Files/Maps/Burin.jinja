{% include 'Maps/Generator/MapTemplate.jinja' %}
{% import 'Maps/Generator/MapUtils.jinja' as sysutil %}
{% import 'Constants.xml' as const %}

{% set timer_interval = 2 %}
{% set energy_per_interval = 10 %}
{% set blue = 2 %}
{% set yellow = 3 %}

{% set num_ring_fragments = 220 %}

{% call sysutil.runOnMapLoad(g.map) %}
  <set_timer name="Burin_Nebula_Tick" seconds="{{ timer_interval }}" />
  <set_variable name="Burin_NearBlue" value="0.0" integer="yes" />
  <set_variable name="Burin_NearYellow" value="0.0" integer="yes" />
  {% for ship in const.shipConfigs %}
    <set_variable name="Burin_Ship{{ ship.id }}DamageType" randomIntLow="1.0" randomIntHigh="8.0" integer="yes" />
    <set_variable name="Burin_Ship{{ ship.id }}NodeSelect" randomIntLow="0.0" randomIntHigh="4.0" integer="yes" />
  {% endfor %}
{% endcall %}

{% call sysutil.runIfInSector(g.map, [4]) %}
  {% set burin_x = 52823 %}
  {% set burin_y = 53277 %}
  {% set ring_radius = 3000 %}
  {% set ring_spread = 200 %}
  <if_variable name="Burin_4_Ring" comparator="NOT" value="1.0" />

  {% for i in range(num_ring_fragments) %}
    <create type="genericMesh" x="{{
         burin_x + (sin(i*6.283/num_ring_fragments) * (ring_radius + randint(-ring_spread, ring_spread))) | int
       }}.0" y="0.0" z="{{
         burin_y + (cos(i*6.283/num_ring_fragments) * (ring_radius + randint(-ring_spread, ring_spread))) | int
       }}.0" name="x" meshFileName="dat\asteroid{{ randint(6,11) }}.dxs" textureFileName="dat\white32.png" colorRed="1.0" colorGreen="1.0" colorBlue="1.0" />

    <set_object_property property="artScale" value="0.1" name="x" />
    <set_object_property property="pushRadius" value="62" name="x" />
    <set_object_property property="angleDelta" value="0.{{ randint(10, 19) }}" name="x" />
    <set_ship_text name="x" newname=" " class="Ring Fragment" />
  {% endfor %}

  <set_variable name="Burin_4_Ring" value="1.0" integer="yes" />
{% endcall %}
{% call sysutil.runIfNotInSector(g.map, [4]) %}
  <if_variable name="Burin_4_Ring" comparator="EQUALS" value="1.0" />
  {% for i in range(num_ring_fragments) %}
    <destroy name=" " />
  {% endfor %}
  <set_variable name="Burin_4_Ring" value="0.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.map, [2,5,6]) %}
  <if_variable name="Burin_NearBlue" comparator="NOT" value="1.0" />
  <warning_popup_message message="Warning: Ionized particles detected in nearby blue nebulae." consoles="MHWESCO" />
  <set_variable name="Burin_NearBlue" value="1.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.map, [1,4,5]) %}
  <if_variable name="Burin_NearYellow" comparator="NOT" value="1.0" />
  <warning_popup_message message="Warning: Corrosive particles detected in nearby green nebulae." consoles="MHWESCO" />
  <set_variable name="Burin_NearYellow" value="1.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.map, [1,3,4]) %}
  <if_variable name="Burin_NearBlue" comparator="EQUALS" value="1.0" />
  <set_variable name="Burin_NearBlue" value="0.0" integer="yes" />
{% endcall %}

{% call sysutil.runIfInSector(g.map, [2,3,6]) %}
  <if_variable name="Burin_NearYellow" comparator="EQUALS" value="1.0" />
  <set_variable name="Burin_NearYellow" value="0.0" integer="yes" />
{% endcall %}

{% for ship in const.shipConfigs %}
  {% call sysutil.runIfOnMap(g.map) %}
    <!-- Blue Nebula Tick Ship{{ ship.id }} -->
    <if_timer_finished name="Burin_Nebula_Tick" />
    <if_in_nebula player_slot="{{ ship.slot }}" compare="{{ blue }}" />
    <if_object_property player_slot="{{ ship.slot }}" property="energy" comparator="GREATER" value="50" />
    <addto_object_property value="-{{ energy_per_interval }}" property="energy" player_slot="{{ ship.slot }}" />
  {% endcall %}
  
  {% for system, name in const.systemIdentifiers.items() %}
    {% set systemID = loop.index %}
    {% call sysutil.runIfOnMap(g.map) %}
      <!-- Yellow Nebula Tick Ship{{ ship.id }} - Damage {{ name }} -->
      <if_timer_finished name="Burin_Nebula_Tick" />
      <if_in_nebula player_slot="{{ ship.slot }}" compare="{{ yellow }}" />
      <if_variable name="Burin_Ship{{ ship.id }}DamageType" comparator="EQUALS" value="{{ systemID }}.0" />
      {% if system != "warp" %}
        <set_player_grid_damage value="0.1" player_slot="{{ ship.slot }}" index="Burin_Ship{{ ship.id }}NodeSelect" systemType="{{ name }}" countFrom="front" />
      {% endif %}

      <set_variable name="Burin_Ship{{ ship.id }}DamageType" randomIntLow="1.0" randomIntHigh="8.0" integer="yes" />
      <set_variable name="Burin_Ship{{ ship.id }}NodeSelect" randomIntLow="0.0" randomIntHigh="4.0" integer="yes" />
    {% endcall %}
  {% endfor %}

{% endfor %}

{% call sysutil.runIfOnMap(g.map) %}
  <!-- Timer Reset -->
  <if_timer_finished name="Burin_Nebula_Tick" />
  <set_timer name="Burin_Nebula_Tick" seconds="{{ timer_interval }}" />
{% endcall %}