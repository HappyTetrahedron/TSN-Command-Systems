{% macro _buttonGrid(buttons, x, y, w, h, rows, padding=2) %}
  {% for buttondata in buttons %}
    {% if buttondata.type == "standard" %}
      <set_gm_button text="{{ buttondata.name }}" x="{{ x + (loop.index0 / rows)|int * w }}" y="{{ y + (loop.index0 % rows) * h }}" w="{{ w - padding }}" h="{{ h - padding }}" />
    {% elif buttondata.type == "toggle" %}
      <set_variable name="Toggle_{{ buttondata.name }}_ShouldShow" value="1" integer="yes" />
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro _buttonHandlersNonStandard(name, x, y, w, h, rows, padding=2) %}
  {% for buttondata in retrieve("specialbuttons" + name) %}
    {% if buttondata.type == "toggle" %}
      {{ toggle.Toggle(buttondata.name, buttondata.variable, buttondata.valueMap, buttondata.x, buttondata.y, buttondata.w, buttondata.h) }}
    {% endif %}
  {% endfor %}
  {% for buttondata in retrieve("buttons" + name) %}
    {% if buttondata.type == "toggle" %}
      {{ toggle.Toggle(buttondata.name, buttondata.variable, buttondata.valueMap, x + (loop.index0 / rows)|int * w, y + (loop.index0 % rows) * h, w - 2, h - 2) }}
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro addDismissableSubmenu(name, parentMenu, pos={}) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% do track("dynamicMenus", {
    "type": "dismissableSubmenu",
    "name": name,
    "parentMenu": pk,
    "pos": pos,
  }, name) %}
{% endmacro %}

{% macro addEphemeralSubmenu(name, parentMenu, pos={}) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% do track("dynamicMenus", {
    "type": "ephemeralSubmenu",
    "name": name,
    "parentMenu": pk,
    "pos": pos,
  }, name) %}
{% endmacro %}

{% macro addPermanentSubmenu(name, parentMenu) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% do track("dynamicMenus", {
    "type": "permanentSubmenu",
    "name": name,
    "parentMenu": pk,
  }, name) %}
{% endmacro %}

{% macro addButtonExpandMenu(name, parentMenu, x, y, w=90, h=30, rows=10, pos={}) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% do track("dynamicMenus", {
    "type": "buttonExpandMenu",
    "name": name,
    "parentMenu": pk,
    "body": caller,
    "x": x,
    "y": y,
    "w": w,
    "h": h,
    "rows": rows,
    "pos": pos,
  }, name) %}
{% endmacro %}

{% macro addMenuToggle(name, parentMenu, variable, valueMap) %}
  {% set pmkey = (parentMenu.key if parentMenu is mapping else parentMenu) %}
  {% call(isCreate) addStatementToMenu(name, parentMenu) %}
    <set_variable name="Toggle_{{ name }}_ShouldShow" value="{{ 1 if isCreate else 0 }}" integer="yes" />
  {% endcall %}
  {{ toggle.Toggle(name, variable, valueMap, parentkey=pmkey) }}
{% endmacro %}

{% macro onMenuClick(name, parentMenu) %}
  {% do track("menukey" + parentMenu, name) %}
  <event name="{{ name }} onClick">
    <if_gm_button text="{{ parentMenu }}\{{ name }}" />
    {{ caller() }}
  </event>
{% endmacro %}

{% macro addButtonToggle(name, parentMenu, variable, valueMap, pos={}) %}
  {% set pmkey = (parentMenu.key if parentMenu is mapping else parentMenu) %}
  {% if pos and "x" in pos and "y" in pos %}
    {% do track("specialbuttons" + pmkey, {"name": name, "type": "toggle", "variable": variable, "valueMap": valueMap, "x": pos.x, "y": pos.y, "w": pos.get("w", 90), "h": pos.get("h", 30)}, name) %}
  {% else %}
    {% do track("buttons" + pmkey, {"name": name, "type": "toggle", "variable": variable, "valueMap": valueMap}, name) %}
  {% endif %}
{% endmacro %}

{% macro onButtonClick(name, parentMenu, pos={}) %}
  {% set pmkey = (parentMenu.key if parentMenu is mapping else parentMenu) %}
  {% if pos and "x" in pos and "y" in pos %}
    {% do track("specialbuttons" + pmkey, {"name": name, "type": "standard", "x": pos.x, "y": pos.y, "w": pos.get("w", 90), "h": pos.get("h", 30)}, name) %}
  {% else %}
    {% do track("buttons" + pmkey, {"name": name, "type": "standard"}, name) %}
  {% endif %}
  <event name="{{ name }} onClick">
    <if_gm_button text="{{ name }}" />
    {{ caller() }}
  </event>
{% endmacro %}

{% macro createLabel(name, parentMenu, x, y, w=90, h=30) %}
  {% do track("specialbuttons" + (parentMenu.key if parentMenu is mapping else parentMenu), { "name": name, "type": "standard", "x": x, "y": y, "w": w, "h":h }, name) %}
{% endmacro %}

{% macro addStatementToMenu(name, parentMenu) %}
  {% do track("extrastatements" + (parentMenu.key if parentMenu is mapping else parentMenu), caller, name) %}
{% endmacro %}

<event name="Build Root Menu">
    <if_variable name="GM_Menu_Root_ShouldShow" comparator="EQUALS" value="1.0" />
    <if_variable name="_GM_Menu_Root_Shown" comparator="NOT" value="1.0" />
    <set_gm_button text="Bas." x="40" y="100" h="30" w="50" />
    <set_gm_button text="SPWN." x="40" y="140" h="30" w="50" />
    <set_gm_button text="POI" x="40" y="180" h="30" w="50" />
    <set_gm_button text="Haz." x="40" y="220" h="30" w="50" />
    <set_gm_button text="Int." x="40" y="260" h="30" w="50" />
    <set_gm_button text="CSTM" x="40" y="300" h="30" w="50" />
    <set_gm_button text="AI Off" x="40" y="380" h="30" w="50" />
    <set_variable name="Toggle_AutoDel_ShouldShow" value="1.0" integer="yes" />
    <set_variable name="_GM_Menu_Root_Shown" value="1.0" integer="yes" />
</event>

  {% set allSubmenus = [] %}
  {% macro _createMenu(name, id) %}
  <event name="Menu Create {{ name }}">
    <if_variable name="GM_Menu_Selector" comparator="EQUALS" value="{{ id }}.0" />
    <if_variable name="_GM_Menu_{{ name }}_Active" comparator="NOT" value="1.0" />
    {{ caller () }}
    {% set menu = main[name] %}
    {{ _buttonGrid(retrieve("buttons" + name), menu.buttons.x, menu.buttons.y, menu.buttons.w, menu.buttons.h, menu.buttons.rows) }}
    {% for specbut in retrieve("specialbuttons" + name) %}
      <set_gm_button text="{{ specbut.name }}" x="{{ specbut.x }}" y="{{ specbut.y }}" w="{{ specbut.w }}" h="{{ specbut.h }}" /> 
    {% endfor %}
    {% for permmenu in retrieve("permSubmenus" + name) %}
      <set_variable name="GM_Submenu_{{ permmenu }}_ShouldShow" value="1.0" integer="yes" />
    {% endfor %}
    {% for buttonsubmenu in retrieve("buttonSubs" + name) %}
      {{ util.restore("GM_Submenu_" + name + buttonsubmenu + "_ShouldShow") }}
    {% endfor %}
    {% for caller in retrieve("extrastatements" + name) %}
      {{ caller(True) }}
    {% endfor %}
    <set_variable name="_GM_Menu_{{ name }}_Active" value="1.0" integer="yes" />
  </event>
  {{ _buttonHandlersNonStandard(name, menu.buttons.x, menu.buttons.y, menu.buttons.w, menu.buttons.h, menu.buttons.rows) }}
  {% endmacro %}
  {% macro _destroyMenu(name, id) %}
  <event name="Menu Destroy {{ name }}">
    <if_variable name="GM_Menu_Selector" comparator="NOT" value="{{ id }}.0" />
    <if_variable name="_GM_Menu_{{ name }}_Active" comparator="EQUALS" value="1.0" />
    {{ caller () }}
    {% for buttondata in retrieve("buttons" + name) %}
      {% if buttondata.type == "standard" %}
        <clear_gm_button text="{{ buttondata.name }}" />
      {% elif buttondata.type == "toggle" %}
        <set_variable name="Toggle_{{ buttondata.name }}_ShouldShow" value="0" integer="yes" />
      {% endif %}
    {% endfor %}
    {% for specbut in retrieve("specialbuttons" + name) %}
      <clear_gm_button text="{{ specbut.name }}" /> 
    {% endfor %}
    {% for permmenu in retrieve("permSubmenus" + name) %}
      <set_variable name="GM_Submenu_{{ permmenu }}_ShouldShow" value="0.0" integer="yes" />
    {% endfor %}
    {% for buttonsubmenu in retrieve("buttonSubs" + name) %}
      {{ util.storeAndSet("GM_Submenu_" + name + buttonsubmenu + "_ShouldShow") }}
    {% endfor %}
    {% for caller in retrieve("extrastatements" + name) %}
      {{ caller(False) }}
    {% endfor %}
    <set_variable name="_GM_Menu_{{ name }}_Active" value="0.0" integer="yes" />
  </event>
  {% endmacro %}
  {% macro _menuEvent(name, id, triggerButton) %}
  <event name="Menu Activate {{ name }}">
    <if_gm_button text="{{triggerButton}}" />
    <set_variable name="GM_Menu_Selector" value="{{ id }}.0" integer="yes" />
  </event>
  {% endmacro %}
  {% macro _createExclusiveSubmenu(name, id, menuname, parent_id) %}
  <event name="{{ menuname }} Menu Create {{ name }}">
    <if_variable name="GM_{{ menuname }}Menu_Selector" comparator="EQUALS" value="{{ id }}.0" />
    <if_variable name="GM_Menu_Selector" comparator="EQUALS" value="{{ parent_id }}.0" />
    <if_variable name="_GM_{{ menuname }}Menu_{{ name }}_Active" comparator="NOT" value="1.0" />
    {{ caller () }}
    <set_variable name="_GM_{{ menuname }}Menu_{{ name }}_Active" value="1.0" integer="yes" />
  </event>
  {% endmacro %}
  {% macro _exclusiveSubmenuEvent(name, triggerButton, id, menuname, parent_id, additional_variables={}) %}
  <event name="{{ menuname }}Menu Activate {{ name }}">
    <if_gm_button text="{{triggerButton}}" />
    <if_variable name="GM_Menu_Selector" comparator="EQUALS" value="{{ parent_id }}.0" />
    <set_variable name="GM_{{ menuname }}Menu_Selector" value="{{ id }}.0" integer="yes" />
    {% for var, val in additional_variables.items() %}
    <set_variable name="{{ var }}" value="{{ val }}.0" integer="yes" />
    {% endfor %}
  </event>
  {% endmacro %}
  {% macro _destroyExclusiveSubmenu(name, id, menuname) %}
  <event name="{{ menuname }} Menu Destroy {{ name }}">
    <if_variable name="GM_{{ menuname }}Menu_Selector" comparator="NOT" value="{{ id }}.0" />
    <if_variable name="_GM_{{ menuname }}Menu_{{ name }}_Active" comparator="EQUALS" value="1.0" />
    {{ caller () }}
    <set_variable name="_GM_{{ menuname }}Menu_{{ name }}_Active" value="0.0" integer="yes" />
  </event>
  {% endmacro %}
  {% macro _createSpawnMenu(name, id) %}
    {% set outercaller = caller() %}
    {% call _createExclusiveSubmenu(name, id, "Spawn", 2) %}
      {{ outercaller }}
    {% endcall %}
  {% endmacro %}
  {% macro _spawnMenuEvent(name, triggerButton, id, defaultSide) %}
    {{ _exclusiveSubmenuEvent(name, triggerButton, id, "Spawn", 2, {"SideValue": defaultSide}) }}
  {% endmacro %}
  {% macro _destroySpawnMenu(name, id) %}
    {% set outercaller = caller() %}
    {% call _destroyExclusiveSubmenu(name, id, "Spawn") %}
      {{ outercaller }}
    {% endcall %}
  {% endmacro %}
  {% macro _createSubmenu(name, retrieve_key="") %}
    {% set retkey = retrieve_key if retrieve_key != "" else name %}
    <event name="SubMenu Create {{ name }}">
      {% do allSubmenus.append(name) %}
      <if_variable name="GM_Submenu_{{ name }}_ShouldShow" comparator="EQUALS" value="1.0" />
      <if_variable name="_GM_Submenu_{{ name }}_Active" comparator="NOT" value="1.0" />
      {{ caller () }}
      {% for permmenu in retrieve("permSubmenus" + retkey) %}
        <set_variable name="GM_Submenu_{{ permmenu }}_ShouldShow" value="1.0" integer="yes" />
      {% endfor %}
      {% for buttonsubmenu in retrieve("buttonSubs" + retkey) %}
        {{ util.restore("GM_Submenu_" + name + buttonsubmenu + "_ShouldShow") }}
      {% endfor %}
      {% for specbut in retrieve("specialbuttons" + retkey) %}
        <set_gm_button text="{{ specbut.name }}" x="{{ specbut.x }}" y="{{ specbut.y }}" w="{{ specbut.w }}" h="{{ specbut.h }}" /> 
      {% endfor %}
      {% for caller in retrieve("extrastatements" + retkey) %}
        {{ caller(True) }}
      {% endfor %}
      <set_variable name="_GM_Submenu_{{ name }}_Active" value="1.0" integer="yes" />
    </event>
  {% endmacro %}
  {% macro _destroySubmenu(name, retrieve_key="") %}
    {% set retkey = retrieve_key if retrieve_key != "" else name %}
    <event name="SubMenu Destroy {{ name }}">
      <if_variable name="GM_Submenu_{{ name }}_ShouldShow" comparator="NOT" value="1.0" />
      <if_variable name="_GM_Submenu_{{ name }}_Active" comparator="EQUALS" value="1.0" />
      {{ caller () }}
      {% for permmenu in retrieve("permSubmenus" + retkey) %}
        <set_variable name="GM_Submenu_{{ permmenu }}_ShouldShow" value="0.0" integer="yes" />
      {% endfor %}
      {% for specbut in retrieve("specialbuttons" + retkey) %}
        <clear_gm_button text="{{ specbut.name }}" /> 
      {% endfor %}
      {% for buttonsubmenu in retrieve("buttonSubs" + retkey) %}
        {{ util.storeAndSet("GM_Submenu_" + name + buttonsubmenu + "_ShouldShow") }}
      {% endfor %}
      {% for caller in retrieve("extrastatements" + retkey) %}
        {{ caller(False) }}
      {% endfor %}
      <set_variable name="_GM_Submenu_{{ name }}_Active" value="0.0" integer="yes" />
  </event>
  {% endmacro %}
  {% macro _dismissEvent(name, buttonPath) %}
  <event name="SubMenu Dismiss {{ name }} ({{ buttonPath }})">
    <if_gm_button text="{{buttonPath}}" />
    <set_variable name="GM_Submenu_{{ name }}_ShouldShow" value="0.0" integer="yes" />
  </event>
  {% endmacro %}
  {% macro _submenuEvent(name, triggerButton, guard=0) %}
  <event name="SubMenu Activate {{ name }}">
    <if_gm_button text="{{triggerButton}}" />
    {% if guard > 0 %}
      <if_variable name="GM_Menu_Selector" comparator="EQUALS" value="{{ guard }}.0" />
    {% endif %}
    <set_variable name="GM_Submenu_{{ name }}_ShouldShow" value="1.0" integer="yes" />
  </event>
  {% endmacro %}

{{ addButtonExpandMenu(ai.aicommands.key, main.ai, 
  ai.aicommands.buttons.x,
  ai.aicommands.buttons.y,
  ai.aicommands.buttons.w,
  ai.aicommands.buttons.h,
  ai.aicommands.buttons.rows,
  pos={
    "x":140,
