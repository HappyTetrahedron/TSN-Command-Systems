{% set dynamicMenus = retrieve("dynamicMenus") %}

{% for menu in dynamicMenus %}

  {% if menu.type == "dismissableSubmenu" %}
    {% set menuname = menu.parentMenu + menu.name %}
    {% if menu.pos and "x" in menu.pos and "y" in menu.pos %}
      {% do track("specialbuttons" + menu.parentMenu, {"name": menu.name, "type": "standard", "x": menu.pos.x, "y": menu.pos.y, "w": menu.pos.get("w", 90), "h": menu.pos.get("h", 30)}, menu.name) %}
    {% else %}
      {% do track("buttons" + menu.parentMenu, {"name": menu.name, "type": "standard"}, menu.name) %}
    {% endif %}
    {% call _createSubmenu(menuname, menu.name) %}
      {% for button in retrieve("menukey" + menu.name) %}
        <set_gm_button text="{{ menu.name }}\{{ button }}" />
      {% endfor %}
      <set_gm_button text="{{ menu.name }}\_Dismiss" />
    {% endcall %}
    {% call _destroySubmenu(menuname, menu.name) %}
      {% for button in retrieve("menukey" + menu.name) %}
        <clear_gm_button text="{{ menu.name }}\{{ button }}" />
      {% endfor %}
      <clear_gm_button text="{{ menu.name }}\_Dismiss" />
    {% endcall %}
    {{ _submenuEvent(menuname, menu.name) }}
    {{ _dismissEvent(menuname, menu.name + "\\_Dismiss") }}
  {% endif %}

  {% if menu.type == "permanentSubmenu" %}
    {% set menuname = menu.parentMenu + menu.name %}
    {% do track("permSubmenus" + menu.parentMenu, menuname) %}
    {% call _createSubmenu(menuname, menu.name) %}
      {% for button in retrieve("menukey" + menu.name) %}
        <set_gm_button text="{{ menu.name }}\{{ button }}" />
      {% endfor %}
    {% endcall %}
    {% call _destroySubmenu(menuname, menu.name) %}
      {% for button in retrieve("menukey" + menu.name) %}
        <clear_gm_button text="{{ menu.name }}\{{ button }}" />
      {% endfor %}
    {% endcall %}
  {% endif %}

  {% if menu.type == "ephemeralSubmenu" %}
    {% set menuname = menu.parentMenu + menu.name %}
    {% if menu.pos and "x" in menu.pos and "y" in menu.pos %}
      {% do track("specialbuttons" + menu.parentMenu, {"name": menu.name, "type": "standard", "x": menu.pos.x, "y": menu.pos.y, "w": menu.pos.get("w", 90), "h": menu.pos.get("h", 30)}, menu.name) %}
    {% else %}
      {% do track("buttons" + menu.parentMenu, {"name": menu.name, "type": "standard"}, menu.name) %}
    {% endif %}
    {% set ephButtons = retrieve("menukey" + menu.name) %}
    {% call _createSubmenu(menuname, menu.name) %}
      {% for button in ephButtons %}
        <set_gm_button text="{{ menu.name }}\{{ button }}" />
      {% endfor %}
    {% endcall %}
    {% call _destroySubmenu(menuname, menu.name) %}
      {% for button in ephButtons %}
        <clear_gm_button text="{{ menu.name }}\{{ button }}" />
      {% endfor %}
    {% endcall %}
    {{ _submenuEvent(menuname, menu.name) }}
    {% for button in ephButtons %}
      {{ _dismissEvent(menuname, menu.name + "\\" + button) }}
    {% endfor %}
  {% endif %}

  {% if menu.type == "buttonExpandMenu" %}
    {% set menuname = menu.parentMenu + menu.name %}
    {% if menu.pos and "x" in menu.pos and "y" in menu.pos %}
      {% do track("specialbuttons" + menu.parentMenu, {"name": menu.name, "type": "standard", "x": menu.pos.x, "y": menu.pos.y, "w": menu.pos.get("w", 90), "h": menu.pos.get("h", 30)}, menu.name) %}
    {% else %}
      {% do track("buttons" + menu.parentMenu, {"name": menu.name, "type": "standard"}, menu.name) %}
    {% endif %}
    {% do track("buttonSubs" + menu.parentMenu, menu.name) %}
    {% set buttons = retrieve("buttons" + menu.name) %}
    {% call _createSubmenu(menuname, menu.name) %}
      {% if menu.body %}
        {{ menu.body(True) }}
      {% endif %}
      {{ _buttonGrid(buttons + [{"name": menu.name + " Close", "type": "standard"}], menu.x, menu.y, menu.w, menu.h, menu.rows) }}
    {% endcall %}
    {% call _destroySubmenu(menuname, menu.name) %}
      {% if menu.body %}
        {{ menu.body(False) }}
      {% endif %}
      {% for buttondata in retrieve("buttons" + menu.name) %}
        {% if buttondata.type == "standard" %}
          <clear_gm_button text="{{ buttondata.name }}" />
        {% elif buttondata.type == "toggle" %}
          <set_variable name="Toggle_{{ buttondata.name }}_ShouldShow" value="0" integer="yes" />
        {% endif %}
      {% endfor %}
      <clear_gm_button text="{{ menu.name }} Close" />
    {% endcall %}
    {{ _submenuEvent(menuname, menu.name) }}
    {{ _dismissEvent(menuname, menu.name + " Close") }}
    {{ _buttonHandlersNonStandard(menu.name, menu.x, menu.y, menu.w, menu.h, menu.rows) }}
  {% endif %}

{% endfor %}

{# "Normal" menus: #}
  {% for menu in main.values() if not menu.special %} 
    {% call _createMenu(menu.key, menu.id) %}
    {% endcall %}
    {% call _destroyMenu(menu.key, menu.id) %}
    {% endcall %}
    {{ _menuEvent(menu.key, menu.id, menu.button) }}
  {% endfor %}


{# Menus that work in peculiar ways: #}
  {# Spawn menu #}
  {% call _createMenu(main.spawn.key, main.spawn.id) %}
    {{ util.restore("GM_SpawnMenu_Selector") }}
    {% for faction in util.spawnFactions.values() %}
    <set_gm_button text="{{ faction.name | safe }}" x="{{ 100 + 75 * (loop.index0 % 2) }}" y="{{ 170 + 35 * ((loop.index0 / 2)|int) }}" h="30" w="70" />
    {% endfor %}
  {% endcall %}
  {% call _destroyMenu(main.spawn.key, main.spawn.id) %}
    {{ util.storeAndSet("GM_SpawnMenu_Selector") }}
    {% for faction in util.spawnFactions.values() %}
    <clear_gm_button text="{{ faction.name | safe }}" />
    {% endfor %}
  {% endcall %}
  {{ _menuEvent(main.spawn.key, main.spawn.id, main.spawn.button) }}

  {% for faction in util.spawnFactions.values() %}
    {{ _spawnMenuEvent("Spawn" + faction.name, faction.name, faction.key, faction.defaultSide) }}
  {% endfor %}

  {% for faction in util.spawnFactions.values() %}
    {% set buttons = retrieve("spawn" + faction.key) %}
    {% call _createSpawnMenu("Spawn" + faction.name, faction.key) %}
      {% for b in buttons %}
        <set_gm_button text="{{ b }}" />
      {% endfor %}
    {% endcall %}
    {% call _destroySpawnMenu("Spawn" + faction.name, faction.key) %}
      {% for b in buttons %}
        <clear_gm_button text="{{ b }}" />
      {% endfor %}
    {% endcall %}
  {% endfor %}


  {# AI menu #}
  {% call _createSubmenu(main.ai.key) %}
    <clear_gm_button text="AI Off" />
    <set_gm_button text="AI On" x="40" y="380" h="30" w="50" />
  {% endcall %}
  {% call _destroySubmenu(main.ai.key) %}
    <clear_gm_button text="AI On" />
    <set_gm_button text="AI Off" x="40" y="380" h="30" w="50" />
  {% endcall %}
  {{ _submenuEvent(main.ai.key, "AI Off") }}
  {{ _dismissEvent(main.ai.key, "AI On") }}


  {# Menu Reset #}
    {% macro _clearAllMenus() %}
    <set_variable name="_GM_Menu_Root_Shown" value="0.0" integer="yes" />
    <set_variable name="GM_Menu_Selector" value="0.0" integer="yes" />
    <set_variable name="GM_SpawnMenu_Selector" value="0.0" integer="yes" />
    {% for submenu in allSubmenus %}
      <set_variable name="GM_Submenu_{{ submenu }}_ShouldShow" value="0.0" integer="yes" />
    {% endfor %}
    <clear_gm_button text="AI Off" />
    <clear_gm_button text="AI On" />
    <clear_gm_button text="Bas." />
    <clear_gm_button text="SPWN." />
    <clear_gm_button text="POI" />
    <clear_gm_button text="Haz." />
    <clear_gm_button text="Int." />
    <clear_gm_button text="CSTM" />
    <clear_gm_button text="Spwn Dsbld" />
    <clear_gm_button text="Delete Dsble" />
    <clear_gm_button text="Spwn Enbld" />
    <clear_gm_button text="Delete Enbld" />
    <set_variable name="Toggle_AutoDel_ShouldShow" value="0.0" integer="yes" />
    <set_variable name="GM_Menu_Clear_All" value="0.0" integer="yes" />
    {% endmacro %}

  {{ toggle.Toggle("AutoDel", "Auto Delete", [("DelOff", 0), ("DelOn", 1)], 40, 340, 50, 30) }}

  <event name="Refresh All Menus">
    <if_variable name="GM_Menu_Clear_All" comparator="GREATER_EQUAL" value="1.0" />
    {{ _clearAllMenus() }}
  </event>

  <event name="Hide All Menus">
    <if_variable name="GM_Menu_Root_ShouldShow" comparator="NOT" value="1.0" />
    <if_variable name="_GM_Menu_Root_Shown" comparator="EQUALS" value="1.0" />
    {{ _clearAllMenus() }}
  </event>
