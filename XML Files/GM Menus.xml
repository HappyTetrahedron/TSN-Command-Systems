{% macro addDismissableSubmenu(name, parentMenu, button="", pos={}) %}
  {{ _trackMenuWithParentButton(name, parentMenu, "dismissableSubmenu", button, pos, None, None, None) }}
{% endmacro %}

{% macro addEphemeralSubmenu(name, parentMenu, button="", pos={}) %}
  {{ _trackMenuWithParentButton(name, parentMenu, "ephemeralSubmenu", button, pos, None, None, None) }}
{% endmacro %}

{% macro addPermanentSubmenu(name, parentMenu) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% if pk %} {% do track("permSubmenus" + pk, name) %} {% endif %}
  {{ _trackMenuWithParentButton(name, parentMenu, "permanentSubmenu", {}, None, None, mutexKey, mutexID, nobutton=True) }}
{% endmacro %}

{% macro addMutexSubmenu(name, parentMenu, mutexKey, mutexID, button="", pos={}) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% if pk %} {% do track("mutexSubmenus" + pk, mutexKey) %} {% endif %}
  {{ _trackMenuWithParentButton(name, parentMenu, "permanentSubmenu", button, pos, None, None, mutexKey, mutexID) }}
{% endmacro %}

{% macro addButtonExpandMenu(name, parentMenu, x, y, w=90, h=30, rows=10, button="", pos={}, mutexKey="", mutexID=0) %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% if pk and mutexKey and mutexID %} {% do track("mutexSubmenus" + pk, mutexKey) %}
  {% elif pk %}
    {% do track("buttonSubs" + pk, name) %}
  {% endif %}
  {{ _trackMenuWithParentButton(
    name=name,
    parentMenu=parentMenu,
    type="buttonExpandMenu",
    button=button,
    pos=pos,
    buttons={
      "x": x,
      "y": y,
      "w": w,
      "h": h,
      "rows": rows,
    },
    body=caller,
    mutexKey=mutexKey,
    mutexID=mutexID,
    toggle=True,
  ) }}
{% endmacro %}

{% macro _trackMenuWithParentButton(name, parentMenu, type, button, pos, buttons, body, mutexKey, mutexID, toggle=False, nobutton=False) %}
  {% set but = button if button else name %}
  {% set pk = parentMenu.key if parentMenu is mapping else parentMenu %}
  {% if pk %}
    {% if pos and "x" in pos and "y" in pos %}
      {% do track("specialbuttons" + pk, {
        "name": but,
        "type": "toggle" if toggle else "standard",
        "x": pos.x,
        "y": pos.y,
        "w": pos.get("w", 90),
        "h": pos.get("h", 30),
        "variable": "GM_Submenu_" + but | stripspace + "_ShouldShow",
        "valueMap": [(but + " >", 0), (but + " <", 1)],
      }, name) %}
    {% elif not nobutton %}
      {% do track("buttons" + pk, {
        "name": but,
        "type": "toggle" if toggle else "standard",
        "variable": "GM_Submenu_" + but | stripspace + "_ShouldShow",
        "valueMap": [(but + " >", 0), (but + " <", 1)],
      }, name) %}
    {% endif %}
  {% endif %}
  {% do track("dynamicMenus", {
    "key": name | stripspace,
    "type": type,
    "name": name,
    "parentMenu": pk,
    "buttons": buttons,
    "body": body,
    "selection": "mutex" if mutexKey and mutexID else "independent",
    "mutexKey": mutexKey,
    "button": but,
    "id": mutexID,
  }, name) %}
{% endmacro %}

{% macro addMenuToggle(name, parentMenu, variable, valueMap) %}
  {% set pmkey = (parentMenu.key if parentMenu is mapping else parentMenu) %}
  {% call(isCreate) addStatementToMenu(name, parentMenu) %}
    <set_variable name="Toggle_{{ name | stripspace }}_ShouldShow" value="{{ 1 if isCreate else 0 }}" integer="yes" />
  {% endcall %}
  {{ toggle.Toggle(name, variable, valueMap, parentkey=pmkey) }}
{% endmacro %}

{% macro onMenuClick(name, parentMenu) %}
  {% do track("menukey" + parentMenu, name) %}
  <event name="{{ name }} onClick">
    <if_gm_button text="{{ parentMenu }}\{{ name }}" />
    {{ caller() }}
  </event>
{% endmacro %}

{% macro onMenuClickRaw(name, parentMenu) %}
  {% do track("menukeyRaw" + parentMenu, name) %}
  <event name="{{ name }} onClick">
    <if_gm_button text="{{ name }}" />
    {{ caller() }}
  </event>
{% endmacro %}

{% macro addButtonToggle(name, parentMenu, variable, valueMap, pos={}) %}
  {% set pmkey = (parentMenu.key if parentMenu is mapping else parentMenu) %}
  {% if pos and "x" in pos and "y" in pos %}
    {% do track("specialbuttons" + pmkey, {"name": name, "type": "toggle", "variable": variable, "valueMap": valueMap, "x": pos.x, "y": pos.y, "w": pos.get("w", 90), "h": pos.get("h", 30)}, name) %}
  {% else %}
    {% do track("buttons" + pmkey, {"name": name, "type": "toggle", "variable": variable, "valueMap": valueMap}, name) %}
  {% endif %}
{% endmacro %}

{% macro onButtonClick(name, parentMenu, pos={}) %}
  {% set pmkey = (parentMenu.key if parentMenu is mapping else parentMenu) %}
  {% if pos and "x" in pos and "y" in pos %}
    {% do track("specialbuttons" + pmkey, {"name": name, "type": "standard", "x": pos.x, "y": pos.y, "w": pos.get("w", 90), "h": pos.get("h", 30)}, name) %}
  {% else %}
    {% do track("buttons" + pmkey, {"name": name, "type": "standard"}, name) %}
  {% endif %}
  <event name="{{ name }} onClick">
    <if_gm_button text="{{ name }}" />
    {{ caller() }}
  </event>
{% endmacro %}

{% macro createLabel(name, parentMenu, x, y, w=90, h=30) %}
  {% do track("specialbuttons" + (parentMenu.key if parentMenu is mapping else parentMenu), { "name": name, "type": "standard", "x": x, "y": y, "w": w, "h":h }, name) %}
{% endmacro %}

{% macro addStatementToMenu(name, parentMenu) %}
  {% do track("extrastatements" + (parentMenu.key if parentMenu is mapping else parentMenu), caller, name) %}
{% endmacro %}

{% macro addStatementToMenuButton(name, parentMenu) %}
  {% do track("extrastatementsBtn" + (parentMenu.key if parentMenu is mapping else parentMenu), caller, name) %}
{% endmacro %}

{% macro addVarToMenu(name, parentMenu, var, valueOnOpen, valueOnClose="restore") %}
  {% do track("extravars" + (parentMenu.key if parentMenu is mapping else parentMenu), (var, valueOnOpen, valueOnClose), name) %}
{% endmacro %}

{% macro addVarToMenuButton(name, parentMenu, var, value) %}
  {% do track("extravarsBtn" + (parentMenu.key if parentMenu is mapping else parentMenu), (var, value), name) %}
{% endmacro %}

<event name="Build Root Menu">
