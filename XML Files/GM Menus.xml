    <set_gm_button text="AI Off" x="40" y="380" h="30" w="50" />
    <set_variable name="Toggle_AutoDel_ShouldShow" value="1.0" integer="yes" />
    <set_variable name="_GM_Menu_Root_Shown" value="1.0" integer="yes" />
</event>

  {% set allSubmenus = [] %}
  {% set allMutexes = [] %}


{{ addButtonExpandMenu(ai.aicommands.key, main.ai, 
  ai.aicommands.buttons.x,
  ai.aicommands.buttons.y,
  ai.aicommands.buttons.w,
  ai.aicommands.buttons.h,
  ai.aicommands.buttons.rows,
  ) }}

{% set dynamicMenus = retrieve("dynamicMenus") %}

{# "Normal" menus: #}
  {% for menu in main.values() if not menu.special %} 
    {{ addButtonExpandMenu(menu.key, "", menu.buttons.x, menu.buttons.y, menu.buttons.w, menu.buttons.h, menu.buttons.rows, button=menu.button, mutexKey="Menu", mutexID=menu.id) }}
  {% endfor %}

{% for menu in dynamicMenus %}
  {% if menu.selection != "mutex" %}
    {% do allSubmenus.append(menu.name) %}
  {% else %}
    {% if menu.mutexKey not in allMutexes %}
      {% do allMutexes.append(menu.mutexKey) %}
    {% endif %}
  {% endif %}
  {{ ui.generateMenuEvents(menu) }}
{% endfor %}

{% call ui.activateIndependentMenu(main.ai.key, "AI Off") %}
  <clear_gm_button text="AI Off" />
  <set_gm_button text="AI On" x="40" y="380" h="30" w="50" />
{% endcall %}
{% call ui.dismissIndependentMenu(main.ai.key, "AI On") %}
  <clear_gm_button text="AI On" />
  <set_gm_button text="AI Off" x="40" y="380" h="30" w="50" />
{% endcall %}

  {# Menu Reset #}
    {% macro _clearAllMenus() %}
    <set_variable name="_GM_Menu_Root_Shown" value="0.0" integer="yes" />
    <set_variable name="GM_Menu_Selector" value="0.0" integer="yes" />
    {% for submenu in allSubmenus %}
      <set_variable name="GM_Submenu_{{ submenu | stripspace }}_ShouldShow" value="0.0" integer="yes" />
    {% endfor %}
    {% for mutex in allMutexes %}
      <set_variable name="GM_{{ mutex | stripspace }}_Selector" value="0.0" integer="yes" />
    {% endfor %}
    <clear_gm_button text="AI Off" />
    <clear_gm_button text="AI On" />
    <clear_gm_button text="Bas." />
    <clear_gm_button text="SPWN." />
    <clear_gm_button text="POI" />
    <clear_gm_button text="Haz." />
    <clear_gm_button text="Int." />
    <clear_gm_button text="CSTM" />
    <set_variable name="Toggle_AutoDel_ShouldShow" value="0.0" integer="yes" />
    <set_variable name="GM_Menu_Clear_All" value="0.0" integer="yes" />
    {% endmacro %}

  {{ toggle.Toggle("AutoDel", "Auto Delete", [("DelOff", 0), ("DelOn", 1)], 40, 340, 50, 30) }}

  <event name="Refresh All Menus">
    <if_variable name="GM_Menu_Clear_All" comparator="GREATER_EQUAL" value="1.0" />
    {{ _clearAllMenus() }}
  </event>

  <event name="Hide All Menus">
    <if_variable name="GM_Menu_Root_ShouldShow" comparator="NOT" value="1.0" />
    <if_variable name="_GM_Menu_Root_Shown" comparator="EQUALS" value="1.0" />
    {{ _clearAllMenus() }}
  </event>
