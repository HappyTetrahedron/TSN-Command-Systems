{% import 'Utils.xml' as util %}
{% import 'Start.xml' as start %}
{% import 'GM Menus.xml' as menu %}

{% call start.onStart("Gate System") %}
    <set_variable name="shipsInrange" value="0.0" integer="yes" />
{% endcall %}

{{ menu.addMenuToggle("LockGate", "Locking", "Gates Offline", [("Gates unlocked - click to lock", 0), ("Gates locked - click to unlock", 1)]) }}

<event name="Ship Tracking">
  <if_variable name="shipsInrange" comparator="LESS" value="0.0" />
  <set_variable name="shipsInrange" value="0.0" integer="yes" />
</event>
<event name="Clear Activate and Jump Button">
  <if_variable name="ClearGateBtns" comparator="EQUALS" value="1.0" />
  {% for ship in util.shipConfigs %}
    <clear_comms_button text="Activate Gate" player_slot="{{ ship.slot }}" />
    <clear_comms_button text="Jump" player_slot="{{ ship.slot }}" />
  {% endfor %}
  <set_variable name="ClearGateBtns" value="0.0" integer="yes" />
</event>

{% for ship in util.shipConfigs %}
  <event name="Ship{{ ship.id }} Activate Gate">
    <if_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Gate Tracking Ship{{ ship.id }}" comparator="EQUALS" value="1.0" />
    <if_variable name="Gates Offline" comparator="NOT" value="1.0" />
    <if_variable name="Gate System" comparator="LESS" value="2.0" />
    <set_comms_button text="Activate Gate" player_slot="{{ ship.slot }}" />
    <set_variable name="Gate System" value="1.0" />
  </event>
{% endfor %}

  <event name="Deactive Gate (disabled)" id_arme="036a77e3-3e24-4c79-9213-ec9e5a340863" parent_id_arme="4d100278-3ca4-410d-b427-d409701fcf24">
    <if_variable name="Gate System" comparator="GREATER_EQUALS" value="1.0" />
    <if_variable name="Gates Offline" comparator="EQUALS" value="1.0" />
    <set_variable name="ClearGateBtns" value="1.0" integer="yes" />
    <set_variable name="Gate System" value="0.0" integer="yes" />
  </event>
  <event name="Deactive Gate (all out of range)" id_arme="036a77e3-3e24-4c79-9213-ec9e5a340863" parent_id_arme="4d100278-3ca4-410d-b427-d409701fcf24">
    <if_variable name="Gate System" comparator="EQUALS" value="1.0" />
    <if_variable name="shipsInrange" comparator="LESS" value="1.0" />
    <set_variable name="ClearGateBtns" value="1.0" integer="yes" />
    <set_variable name="Gate System" value="0.0" integer="yes" />
  </event>
  <event name="Deactive Gate (post activation)" id_arme="3d68d7ed-0e36-405c-81a5-2488d80e4ff3" parent_id_arme="4d100278-3ca4-410d-b427-d409701fcf24">
    <if_variable name="Gate System" comparator="GREATER" value="1.0" />
    <if_variable name="shipsInrange" comparator="LESS" value="1.0" />
    <set_variable name="ClearGateBtns" value="1.0" integer="yes" />
    <incoming_comms_text from="Gate System" sideValue="playerSide" type="STATUS">Deactivating Gate</incoming_comms_text>
    <set_variable name="Gate System" value="0.0" />
  </event>
  <event name="Tracking Ships" id_arme="facb4333-876f-48f6-9f89-bb1adb476558" parent_id_arme="4d100278-3ca4-410d-b427-d409701fcf24">
    <if_variable name="Gate System" comparator="EQUALS" value="2.0" />
    <if_timer_finished name="Gate System" />
    <if_variable name="shipsInrange" comparator="LESS" value="shipCount" />
    <set_variable name="ClearGateBtns" value="1.0" integer="yes" />
    <incoming_comms_text from="Gate System" sideValue="playerSide" type="STATUS">Tracking ships...</incoming_comms_text>
    <set_timer name="Gate System" seconds="5" />
  </event>
  <event name="All ships ready">
    <if_variable name="Gate System" comparator="EQUALS" value="2.0" />
    <if_timer_finished name="Gate System" />
    <if_variable name="shipsInrange" comparator="EQUALS" value="shipCount" />
    <incoming_comms_text from="Gate System" sideValue="playerSide" type="STATUS">Signal locked.^Standing by for jump.</incoming_comms_text>
    {% for ship in util.shipConfigs %}
      <set_comms_button text="Jump" player_slot="{{ ship.slot }}" />
    {% endfor %}
    <set_variable name="Gate System" value="3.0" integer="yes" />
  </event>
  <event name="Signal loss detected">
    <if_variable name="Gate System" comparator="GREATER_EQUAL" value="3.0" />
    <if_variable name="shipsInrange" comparator="LESS" value="shipCount" />
    <incoming_comms_text from="Gate System" sideValue="playerSide" type="STATUS">Signal lost, recalculating...</incoming_comms_text>
    <set_variable name="ClearGateBtns" value="1.0" integer="yes" />
    <set_variable name="Gate System" value="2.0" />
  </event>
