  {% endfor %}
{% endcall %}


{% for transition in transitions %}
  {% call(ship, unused) util.shipConditionalEventAnd(transition.conditions) %}
    <if_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" comparator="EQUALS" value="0.0" />
    <set_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" value="1.0" />
  {% endcall %}
  {% call(ship, unused) util.shipConditionalEventOr(transition.conditions, invert=True) %}
    <if_exists player_slot="{{ ship.slot }}" />
    <set_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" value="0.0" />
    <set_variable name="{{ transition.name }} Transition" value="0.0" />
  {% endcall %}
  <event name="{{ transition.name }} Transition Enabled">
    <if_variable name="Sector Locked" comparator="NOT" value="1.0" />
    <if_variable name="shipCount" comparator="GREATER" value="0.0" />
    {% for ship in util.shipConfigs %}
      <if_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" comparator="EQUALS" value="1.0" />
    {% endfor %}
    <if_variable name="{{ transition.name }} Transition Enabled" comparator="EQUALS" value="1.0" />
    <destroy_near type="all" radius="100000" centerX="50000" centerY="0" centerZ="50000" />
    {% for ship in util.shipConfigs %}
      {% for prop, val in transition.get("set", {}).items() %}
        <set_object_property property="{{ prop }}" value="{{ val }}.0" player_slot="{{ ship.slot }}" />
      {% endfor %}
      {% for prop, val in transition.get("add", {}).items() %}
        <addto_object_property property="{{ prop }}" value="{{ val }}.0" player_slot="{{ ship.slot }}" />
      {% endfor %}
    {% endfor %}
    <set_variable name="ExitorRetreat" value="1.0" />
    {% for othertrans in transitions %}
      <set_variable name="{{ othertrans.name }} Transition Enabled" value="0.0" />
    {% endfor %}
    <set_variable name="{{ transition.name }} Transition" value="1.0" />
    <set_variable name="System" value="1.0" integer="yes" />
    <set_variable name="System Settings" value="1.0" integer="yes" />
    {% for hook in retrieve("onMapTransition") %}
      <!--{{ hook.name }}-->
      {{ hook.caller() }}
    {% endfor %}
  </event>
{% endfor %}
