{{ menu.addDismissableSubmenu("Locking", menu.main.base) }}
{{ menu.addMenuToggle("LockSector", "Locking", "Sector Locked", [("Sector unlocked", 0), ("Sector locked", 1)]) }}

{% call(ship) tracking.onInactive("TransitionsEngine") %}
  {% for transition in transitions %}
    <set_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" value="1.0" integer="yes" />
  {% endfor %}
{% endcall %}

{% call(ship) tracking.onDestroy("TransitionsEngine") %}
  {% for transition in transitions %}
    <set_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" value="1.0" integer="yes" />
  {% endfor %}
{% endcall %}


{% call start.onStart("TransitionsEngine") %}
  <set_timer name="Transition" seconds="1" />
  <set_variable name="Sector Locked" value="0.0" integer="yes" />
{% endcall %}


{{ menu.createLabel("Transitions", menu.main.base, 100, 280, 90, 28) }}
{% call menu.onButtonClick("UP   /\\", menu.main.base, pos={ "x":130, "y":310, "w":30, "h":25}) %}
  {% for ship in util.shipConfigs %}
    <set_object_property property="positionZ" value="10.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="positionX" value="{{ 49000  + 100 * loop.index0 }}.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="angle" value="3.141592654" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}
{% call menu.onButtonClick("DOWN   V", menu.main.base, pos={"x":130, "y":370, "w":30, "h":25}) %}
  {% for ship in util.shipConfigs %}
    <set_object_property property="positionZ" value="99990.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="positionX" value="{{ 49000  + 100 * loop.index0 }}.0" player_slot="{{ ship.slot }}" />
