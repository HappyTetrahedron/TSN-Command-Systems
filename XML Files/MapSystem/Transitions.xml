{% call start.onStart("TransitionsEngine") %}
  <set_timer name="Transition" seconds="1" />
{% endcall %}


{{ menu.createLabel("Transitions", menu.main.base, 100, 220, 90, 28) }}
{% call menu.onButtonClick("UP   /\\", menu.main.base, pos={ "x":130, "y":250, "w":30, "h":25}) %}
  {% for ship in util.shipConfigs %}
    <set_object_property property="positionZ" value="10.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="positionX" value="{{ 49000  + 100 * loop.index0 }}.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="angle" value="3.141592654" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}
{% call menu.onButtonClick("DOWN   V", menu.main.base, pos={"x":130, "y":310, "w":30, "h":25}) %}
  {% for ship in util.shipConfigs %}
    <set_object_property property="positionZ" value="99990.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="positionX" value="{{ 49000  + 100 * loop.index0 }}.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="angle" value="0.0" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}
{% call menu.onButtonClick("LEFT   <<", menu.main.base, pos={"x":100, "y":280, "w":30, "h":25}) %}
  {% for ship in util.shipConfigs %}
    <set_object_property property="positionX" value="99990.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="positionZ" value="{{ 49000  + 100 * loop.index0 }}.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="angle" value="1.570796327" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}
{% call menu.onButtonClick("RIGHT   >>", menu.main.base, pos={"x":160, "y":280, "w":30, "h":25}) %}
  {% for ship in util.shipConfigs %}
    <set_object_property property="positionX" value="10.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="positionZ" value="{{ 49000  + 100 * loop.index0 }}.0" player_slot="{{ ship.slot }}" />
    <set_object_property property="angle" value="4.71238898" player_slot="{{ ship.slot }}" />
  {% endfor %}
{% endcall %}


{% for transition in transitions %}
  {% call(ship, unused) util.shipConditionalEventAnd(transition.conditions) %}
    <if_exists player_slot="{{ ship.slot }}" />
    <if_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" comparator="EQUALS" value="0.0" />
    <set_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" value="1.0" />
  {% endcall %}
  {% call(ship, unused) util.shipConditionalEventOr(transition.conditions, invert=True) %}
    <if_exists player_slot="{{ ship.slot }}" />
    <set_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" value="0.0" />
    <set_variable name="{{ transition.name }} Transition" value="0.0" />
  {% endcall %}
  <event name="{{ transition.name }} Transition Enabled">
    <if_variable name="Sector Locked" comparator="NOT" value="1.0" />
    {% for ship in util.shipConfigs %}
      <if_variable name="Ship{{ ship.id }} Ready {{ transition.name }}" comparator="EQUALS" value="1.0" />
    {% endfor %}
    <if_variable name="{{ transition.name }} Transition Enabled" comparator="EQUALS" value="1.0" />
    <destroy_near type="all" radius="100000" centerX="50000" centerY="0" centerZ="50000" />
    <set_variable name="Static_BH" value="3.0" integer="yes" />
    <set_variable name="Dynamic_BH" value="3.0" integer="yes" />
    {% for ship in util.shipConfigs %}
      {% for prop, val in transition.get("set", {}).items() %}
        <set_object_property property="{{ prop }}" value="{{ val }}.0" player_slot="{{ ship.slot }}" />
      {% endfor %}
      {% for prop, val in transition.get("add", {}).items() %}
        <addto_object_property property="{{ prop }}" value="{{ val }}.0" player_slot="{{ ship.slot }}" />
      {% endfor %}
    {% endfor %}
    <set_variable name="ExitorRetreat" value="1.0" />
    {% for othertrans in transitions %}
      <set_variable name="{{ othertrans.name }} Transition Enabled" value="0.0" />
    {% endfor %}
    <set_variable name="{{ transition.name }} Transition" value="1.0" />
    <set_variable name="System" value="1.0" integer="yes" />
    <set_variable name="System Settings" value="1.0" integer="yes" />
    {% for caller in retrieve("onMapTransition") %}
      {{ caller() }}
    {% endfor %}
  </event>
{% endfor %}
