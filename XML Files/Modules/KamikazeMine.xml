{# KamikazeMine module - add a shuttle-deployable mine field to a ship. #}

{% set moduleName = "KamikazeMine" %}
{% set mineCargo = "101" %}
{% set timer = "30" %}

{% macro render(ship, util) %}
  {% set marker = "CL." + ship.id + "0" %}

  {# Menu Lifecycle #}
  {% call() util.createConditionalModuleButtons(ship, moduleName + "ClusterDeploy") %}
    {{ util.ifCommsMenuState(ship, 2) }}
    <if_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_Used" comparator="NOT" value="1.0" />
    {{ util.sendCommsButton("Load Bombs", ship) }}
  {% endcall %}

  {% call() util.destroyConditionalModuleButtons(ship, moduleName + "ClusterDeploy") %}
    {{ util.ifCommsMenuState(ship, 2, "NOT") }}
    {{ util.clearCommsButton("Load Bombs", ship) }}
  {% endcall %}

  {% call() util.destroyConditionalModuleButtons(ship, moduleName + "ClusterDeploy") %}
    <if_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_Used" comparator="EQUALS" value="1.0" />
    {{ util.clearCommsButton("Load Bombs", ship) }}
  {% endcall %}

  {% call util.destroyConditionalModuleButtons(ship, moduleName + "ClusterDeploy") %}
    <if_exists name="{{ marker }}" />
    {{ util.clearCommsButton("Deploy Cluster", ship) }}
  {% endcall %}

  {% call util.createConditionalModuleButtons(ship, moduleName + "ClusterActivate") %}
    {{ util.ifCommsMenuState(ship, 3) }}
    <if_exists name="{{ marker }}" />
    {{ util.sendCommsButton("Activate Cluster", ship) }}
  {% endcall %}

  {% call util.destroyConditionalModuleButtons(ship, moduleName + "ClusterActivate") %}
    {{ util.ifCommsMenuState(ship, 3, "NOT") }}
    {{ util.clearCommsButton("Activate Cluster", ship) }}
  {% endcall %}

  {% call util.destroyConditionalModuleButtons(ship, moduleName + "ClusterActivate") %}
    <if_not_exists name="{{ marker }}" />
    {{ util.clearCommsButton("Activate Cluster", ship) }}
  {% endcall %}

  {# Button Handling #}

  {% call util.onModuleButtonPressed("Load Bombs", ship) %}
    <if_exists player_slot="{{ ship.slot }}" />
    <incoming_comms_text from="CHANNEL {{ ship.id }}" sideValue="playerSide" type="STATUS">Orders received. Stand by whilst we configure {{ ship.shuttle }} as requested.</incoming_comms_text>
    <warning_popup_message message="Loading {{ ship.shuttle }}" consoles="MC" player_slot="{{ ship.slot }}" />
    <set_variable name="ShuttleSelect" value="{{ ship.id }}" integer="yes" />
    <set_timer name="ShuttleOps" seconds="2" />
    <set_variable name="OperationType" value="{{ mineCargo }}.0" integer="yes" />
  {% endcall %}

  {% call util.onModuleButtonPressed("Shuttle Status", ship) %}
    <if_exists player_slot="{{ ship.slot }}" />
    <if_variable name="{{ ship.shuttle }}CargoType" comparator="EQUALS" value="{{ mineCargo }}.0" />
    <incoming_comms_text from="CHANNEL {{ ship.id }}" sideValue="playerSide" type="STATUS">{{ ship.shuttle }} has a deployable mine field loaded.^The deployment timer is 30 seconds.</incoming_comms_text>
  {% endcall %}


  {# Loading and Unloading #}
  <event name="Ship {{ ship.id }} Load Bombs">
    <if_variable name="ShuttleSelect" comparator="EQUALS" value="1" />
    <if_variable name="OperationType" comparator="EQUALS" value="{{ mineCargo }}.0" />
    <if_timer_finished name="ShuttleOps" />
    <if_variable name="{{ ship.shuttle }} Status" comparator="EQUALS" value="2.0" />
    <if_variable name="{{ ship.shuttle }}CurrentCargo" comparator="LESS" value="{{ ship.shuttle }}MaxCargo" />
    <if_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_Used" comparator="NOT" value="1.0" />
    <set_variable name="ShuttleSelect" value="0.0" integer="yes" />
    <set_variable name="OperationType" value="0.0" integer="yes" />
    <warning_popup_message message="Deployable mine field loaded." consoles="MCF" player_slot="0" />
    <incoming_comms_text from="{{ ship.shuttle }}" sideValue="playerSide" type="STATUS">Deployable mine field loaded and armed. Deploy timer is {{ timer }} seconds.</incoming_comms_text>
    <set_variable name="ProteusCurrentCargo" value="ProteusCurrentCargo+1" integer="yes" />
    <set_variable name="ProteusCargoType" value="{{ mineCargo }}.0" integer="yes" />
    <!--Modify Ship Inventory-->
    <set_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_Used" value="1.0" integer="yes" />
  </event>

  <event name="Ship {{ ship.id }} Unload Mines">
    <if_variable name="ShuttleSelect" comparator="EQUALS" value="1" />
    <if_variable name="OperationType" comparator="EQUALS" value="1.0" />
    <if_timer_finished name="ShuttleOps" />
    <if_variable name="{{ ship.shuttle }} Status" comparator="EQUALS" value="2.0" />
    <if_variable name="{{ ship.shuttle }}CurrentCargo" comparator="GREATER" value="0.0" />
    <if_variable name="{{ ship.shuttle }}CargoType" comparator="EQUALS" value="{{ mineCargo }}.0" />
    <set_variable name="{{ ship.shuttle }}CurrentCargo" value="0.0" integer="yes" />
    <set_variable name="ShuttleSelect" value="0.0" integer="yes" />
    <set_variable name="OperationType" value="0.0" integer="yes" />
    <warning_popup_message message="Shuttle Unloaded" consoles="MCF" player_slot="0" />
    <incoming_comms_text from="{{ ship.shuttle }}" sideValue="playerSide" type="STATUS">Deployable mine field safed and unloaded.</incoming_comms_text>
    <set_variable name="{{ ship.shuttle }}CargoType" value="0.0" integer="yes" />
    <!--Modify Ship Inventory-->
    <set_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_Used" value="0.0" integer="yes" />
  </event>



  {# Deployment #}

  <event name="Ship {{ ship.id }} Mines Timer Start">
    <if_exists name="{{ ship.shuttle }}" />
    <if_variable name="{{ ship.shuttle }}CurrentCargo" comparator="GREATER" value="0.0" />
    <if_variable name="{{ ship.shuttle }}CargoType" comparator="EQUALS" value="{{ mineCargo }}.0" />
    <if_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_TimerArmed" comparator="NOT" value="1.0" />
    <warning_popup_message message="Mine Deployment Countdown Started - {{ timer }} seconds" consoles="MCF" player_slot="{{ ship.slot }}" />
    <set_timer name="Module_{{ moduleName }}_Ship{{ ship.id }}_Timer" seconds="30" />
    <set_timer name="Module_{{ moduleName }}_Ship{{ ship.id }}_CountdownTimer" seconds="25" />
    <set_variable name="KMShip{{ ship.id }}CD" value="5" integer="yes" />
    <set_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_TimerArmed" value="1.0" integer="yes" />
  </event>

  <event name="Ship {{ ship.id }} Mines Countdown">
      <if_variable name="KMShip{{ ship.id }}CD" comparator="GREATER" value="0.0" />
      <if_timer_finished name="Module_{{ moduleName }}_Ship{{ ship.id }}_CountdownTimer"/>
      <warning_popup_message message="Countdown: |KMShip{{ ship.id }}CD|" consoles="F" player_slot="{{ ship.slot }}" />
      <set_variable name="KMShip{{ ship.id }}CD" value="KMShip{{ ship.id }}CD - 1"  integer="yes" />
      <set_timer name="Module_{{ moduleName }}_Ship{{ ship.id }}_CountdownTimer" seconds="1" />
  </event>

  <event name="Ship {{ ship.id }} Mines Deploy Phase 1">
    <if_exists name="{{ ship.shuttle }}" />
    <if_timer_finished name="Module_{{ moduleName }}_Ship{{ ship.id }}_Timer"/>
    <if_variable name="{{ ship.shuttle }}CurrentCargo" comparator="GREATER" value="0.0" />
    <if_variable name="{{ ship.shuttle }}CargoType" comparator="EQUALS" value="{{ mineCargo }}.0" />

    
    <!-- get coordinates for mines -->
    <get_object_property property="positionX" name="{{ ship.shuttle }}" variable="Module_{{ moduleName}}_{{ ship.shuttle }}_X" />
    <get_object_property property="positionY" name="{{ ship.shuttle }}" variable="Module_{{ moduleName}}_{{ ship.shuttle }}_Y" />
    <get_object_property property="positionZ" name="{{ ship.shuttle }}" variable="Module_{{ moduleName}}_{{ ship.shuttle }}_Z" />

    <!-- reset shuttle cargo mines -->
    <warning_popup_message message="Minefield deployed" consoles="MCF" player_slot="{{ ship.slot }}" />
    <set_variable name="{{ ship.shuttle }}CurrentCargo" value="0.0" integer="yes" />
    <set_variable name="{{ ship.shuttle }}CargoType" value="0.0" integer="yes" />

    <set_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_TimerArmed" value="0.0" integer="yes" />
    <set_timer name="Module_{{ moduleName }}_Ship{{ ship.id }}_DeployTimer" seconds="1" />
  </event>

  <event name="Ship {{ ship.id }} Mines Deploy Phase 2">
      <if_exists name="{{ ship.shuttle }}" />
      <if_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_MinesDeployed" comparator="NOT" value="1.0" />
      <if_timer_finished name="Module_{{ moduleName }}_Ship{{ ship.id }}_DeployTimer"/>

      <!-- deploy mines -->
      <create count="1" type="mines" startX="Module_{{ moduleName}}_{{ ship.shuttle }}_X" startY="Module_{{ moduleName}}_{{ ship.shuttle }}_Y" startZ="Module_{{ moduleName}}_{{ ship.shuttle }}_Z" radius="1" />
      <create count="8" type="mines" startX="Module_{{ moduleName}}_{{ ship.shuttle }}_X" startY="Module_{{ moduleName}}_{{ ship.shuttle }}_Y" startZ="Module_{{ moduleName}}_{{ ship.shuttle }}_Z" radius="500" />
      <create count="16" type="mines" startX="Module_{{ moduleName}}_{{ ship.shuttle }}_X" startY="Module_{{ moduleName}}_{{ ship.shuttle }}_Y" startZ="Module_{{ moduleName}}_{{ ship.shuttle }}_Z" radius="1000" />

      <set_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_MinesDeployed" value="1.0" integer="yes" />
  </event>

  <event name="Ship {{ ship.id }} Mines Recovered">
    <if_not_exists name="{{ ship.shuttle }}" />
    <if_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_TimerArmed" comparator="EQUALS" value="1.0" />

    <warning_popup_message message="{{ ship.shuttle }} Signal Lost - Countdown Stopped" consoles="MCF" player_slot="{{ ship.slot }}" />

    <set_variable name="Module_{{ moduleName }}_Ship{{ ship.id }}_TimerArmed" value="0.0" integer="yes" />
  </event>

{% endmacro %}