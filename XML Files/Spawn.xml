{% macro spawn(factionKey, category, name, autoAI=0, nameAssign=False, randomDir=False, fleetSettings=False) %}
  {% do track("spawn" + factionKey, category + "\\" + name) %}
  <event name="Spawn {{ name }}">
    <if_gm_button text="{{ category }}\{{ name }}" />
    {{ caller() }}
    {% if autoAI > 0 %}
      <set_variable name="Auto AI Type" value="{{ autoAI }}.0" integer="yes" />
    {% endif %}
    {% if randomDir %}
      <set_variable name="Random Direction" value="1.0" />
    {% endif %}
    {% if nameAssign %}
      <set_variable name="Name Assign" value="1.0" integer="yes" />
    {% endif %}
    {% if fleetSettings %}
      <set_variable name="Fleet Settings" value="1.0" integer="yes" />
    {% endif %}
  </event>
{% endmacro %}

{% macro createPickuppable(prefix, button, counter) %}
  {% do track("spawn12", "Other\\" + button) %}
  <event name="Activate" id_arme="f5e538f7-6b37-41ec-8973-cc871655e6bf" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_gm_button text="Other\{{ button }}" />
    <set_variable name="Spawn_{{ prefix }}" value="1.0" integer="yes" />
  </event>
  <event name="Activate (POI)" id_arme="f5e538f7-6b37-41ec-8973-cc871655e6bf" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_gm_button text="RVs\{{ button }}" />
    <set_variable name="Spawn_{{ prefix }}" value="1.0" integer="yes" />
  </event>
  <event name="All Spawned" id_arme="12628720-c387-49c7-a840-e1bb2288f528" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="1.0" />
    <if_exists name="{{ prefix }} 1" />
    <if_exists name="{{ prefix }} 2" />
    <if_exists name="{{ prefix }} 3" />
    <if_exists name="{{ prefix }} 4" />
    <if_exists name="{{ prefix }} 5" />
    <set_variable name="Spawn_{{ prefix }}" value="0.0" integer="yes" />
  </event>
  <event name="Lifepod Spawn" id_arme="952e1377-fe9b-45e9-8877-188d7a21cd39" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="1.0" />
    <if_not_exists name="{{ prefix }} |{{ counter }}|" />
    {{ caller() }}
    <set_variable name="Spawn_{{ prefix }}" value="3.0" integer="yes" />
  </event>
  <event name="Lifepod Skip" id_arme="5a236afc-4569-441b-a591-a037a907b1cf" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="1.0" />
    <if_exists name="{{ prefix }} |lifepodNumber|" />
    <set_variable name="Spawn_{{ prefix }}" value="4.0" integer="yes" />
  </event>
  <folder_arme name="Skip Pod Spawn" id_arme="518f7533-d725-4aa6-b4bd-532d1226433d" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618" />
  <event name="Increment Pod Number" id_arme="72d9d21b-afef-44ae-bdaa-5d36bc43be05" parent_id_arme="518f7533-d725-4aa6-b4bd-532d1226433d">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="4.0" />
    <if_variable name="{{ counter }}" comparator="LESS" value="5.0" />
    <set_variable name="{{ counter }}" value="{{ counter }}+1" integer="yes" />
    <set_variable name="Spawn_{{ prefix }}" value="1.0" integer="yes" />
  </event>
  <event name="Reset Pod Number" id_arme="d0cb18ca-aad0-4536-b495-35b6c04342d1" parent_id_arme="518f7533-d725-4aa6-b4bd-532d1226433d">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="4.0" />
    <if_variable name="{{ counter }}" comparator="GREATER_EQUAL" value="5.0" />
    <set_variable name="{{ counter }}" value="1.0" integer="yes" />
    <set_variable name="Spawn_{{ prefix }}" value="1.0" integer="yes" />
  </event>
  <event name="Increment Pod Number" id_arme="b0530d03-2239-46a8-a824-eb65b568da84" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="3.0" />
    <if_variable name="{{ counter }}" comparator="LESS" value="5.0" />
    <set_variable name="{{ counter }}" value="{{ counter }}+1" integer="yes" />
    <set_variable name="Spawn_{{ prefix }}" value="0.0" integer="yes" />
  </event>
  <event name="Reset Pod Number" id_arme="a61108ff-faea-4578-985f-772083c71fba" parent_id_arme="d1f2a3f4-0b1e-4741-ae53-7b1b27581618">
    <if_variable name="Spawn_{{ prefix }}" comparator="EQUALS" value="3.0" />
    <if_variable name="{{ counter }}" comparator="GREATER_EQUAL" value="5.0" />
    <set_variable name="{{ counter }}" value="1.0" integer="yes" />
    <set_variable name="Spawn_{{ prefix }}" value="0.0" integer="yes" />
  </event>
{% endmacro %}

