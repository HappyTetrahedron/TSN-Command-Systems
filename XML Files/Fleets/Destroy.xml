{# Destroy auto-named object. Refers to dynamic state - include this at the end. #}
{% import 'Utils.xml' as util %}
{% import 'GM Menus.xml' as menu %}
{% import 'Start.xml' as start %}

{% macro onDestroy(identifier) %}
  {% do track("onDestroy", caller, identifier) %}
{% endmacro %}

{% call start.onStart("Destruction") %}
    <set_variable name="Auto Delete" value="0.0" integer="yes" />
    <set_variable name="combinednumber0" value="0.0" integer="yes" />
    <set_variable name="combinednumber1" value="9.0" integer="yes" />
    <set_variable name="combinednumber2" value="19.0" integer="yes" />
    <set_variable name="combinednumber3" value="29.0" integer="yes" />
    <set_variable name="combinednumber4" value="39.0" integer="yes" />
    <set_variable name="combinednumber5" value="49.0" integer="yes" />
    <set_variable name="combinednumber6" value="59.0" integer="yes" />
    <set_variable name="combinednumber7" value="69.0" integer="yes" />
    <set_variable name="combinednumber8" value="79.0" integer="yes" />
    <set_variable name="combinednumber9" value="89.0" integer="yes" />
    <set_variable name="StaticBlackhole" value="0.0" integer="yes" />
    <set_variable name="DestroyNamed" value="0.0" integer="yes" />
{% endcall %}

{% call menu.onButtonClick("DelShips", menu.main.base) %}
    <set_variable name="DestroyNamed" value="1.0" integer="yes" />
{% endcall %}

  <event name="Begin Cycle">
    <if_variable name="DestroyNamed" comparator="EQUALS" value="1.0" />
    {% for i in range(10) %}
      <set_variable name="combinednumber{{ i }}" value="{{ i * 10 }}.0" integer="yes" />
    {% endfor %}
    <set_gm_button text="DELETING SHIPS" x="150" y="100" h="30" w="200" />
    <set_variable name="DestroyNamed" value="2.0" integer="yes" />
    {% set callers = retrieve("onDestroy") %}
    {% for caller in callers %}
      {{ caller() }}
    {% endfor %}
  </event>

  <event name="Destroy">
    <if_variable name="DestroyNamed" comparator="EQUALS" value="2.0" />
    {% for cn in range(10) %}
      {% for l in util.FleetLetters %}
        <destroy name="{{ l }}{{ '0' if cn == 0 else '' }}|combinednumber{{ cn }}|" />
      {% endfor %}
      <set_variable name="combinednumber{{ cn }}" value="combinednumber{{ cn }}+1" integer="yes" />
    {% endfor %}
  </event>

  <event name="End Cycle">
    <if_variable name="combinednumber0" comparator="EQUALS" value="10.0" />
    {% for i in range(10) %}
      <set_variable name="combinednumber{{ i }}" value="{{ i * 10 }}.0" integer="yes" />
    {% endfor %}
    <clear_gm_button text="DELETING SHIPS" />
    <set_variable name="DestroyNamed" value="0.0" integer="yes" />
  </event>

  <event name="Auto Destroy Enabled1" id_arme="6540003c-2276-4027-97e5-f7e0e37e7052" parent_id_arme="1d1f904e-0da9-4f0f-9497-9a3f0077bc0a">
    <if_variable name="Auto Delete" comparator="EQUALS" value="1.0" />
    <if_variable name="ExitorRetreat" comparator="EQUALS" value="1.0" />
    <set_variable name="DestroyNamed" value="1.0" integer="yes" />
    <set_variable name="Auto Delete" value="2.0" integer="yes" />
  </event>
  <event name="Auto Destroy Enabled2" id_arme="f8ede700-4c1e-43d3-bb10-75b6e732e6d2" parent_id_arme="1d1f904e-0da9-4f0f-9497-9a3f0077bc0a">
    <if_variable name="Auto Delete" comparator="EQUALS" value="2.0" />
    <if_variable name="DestroyNamed" comparator="EQUALS" value="0.0" />
    <set_variable name="Auto Delete" value="1.0" integer="yes" />
  </event>

  {# Legacy Alert: These events rely on the main menu managing the toggle button independently. #}
  <event name="Delete Disabled" id_arme="740d30e8-0bc0-42ac-8f09-4d841654414c" parent_id_arme="5db8bbfc-fdc4-4382-9094-b1c3795695b2">
    <if_gm_button text="DelOn" />
    <clear_gm_button text="DelOn" />
    <set_gm_button text="DelOff" x="40" y="340" h="30" w="50" />
    <set_variable name="Auto Delete" value="0.0" integer="yes" />
  </event>
  <event name="Delete Enabled" id_arme="43b93aad-68e8-43da-8e35-370cb3ebdff4" parent_id_arme="5db8bbfc-fdc4-4382-9094-b1c3795695b2">
    <if_gm_button text="DelOff" />
    <clear_gm_button text="DelOff" />
    <set_gm_button text="DelOn" x="40" y="340" h="30" w="50" />
    <set_variable name="Auto Delete" value="1.0" integer="yes" />
  </event>
