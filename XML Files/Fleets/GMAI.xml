  {% for ability in util.abilities %}
  <event name="{{ ability.name }}">
    <if_gm_button text="Assign Specials\Add\{{ ability.name }}" />
    <set_special use_gm_selection="" ship="{{ ability.id }}" />
  </event>
  {% endfor %}
  {% for special in util.specials %}
  <event name="{{ special }}">
    <if_gm_button text="Assign Specials\Add\{{ special }}" />
    <set_special use_gm_selection="" ability="{{ special }}" />
  </event>
  <event name="rm {{ special }}">
    <if_gm_button text="Assign Specials\Clear\{{ special }}" />
    <set_special use_gm_selection="" clear="yes" ability="{{ special }}" />
  </event>
  {% endfor %}
  <event name="Clear All" id_arme="b4203b09-49b5-4c85-86e5-10d24b3a1e90" parent_id_arme="8b2a6ca1-caf3-4f27-bd34-4ec5e4d13b49">
