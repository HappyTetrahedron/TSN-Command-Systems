  {% endcall %}
  {% call menu.onButtonClick("AllyAI", menu.main.ai) %}
    <set_variable name="ReassignAI" value="60.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Guard Bse", menu.main.ai) %}
    <set_variable name="ReassignAI" value="4.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("GoToBase", menu.main.ai) %}
