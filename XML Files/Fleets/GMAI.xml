{% import 'Picker.xml' as picker %}
{% import 'Utils.xml' as util %}
{% import 'GM Menus.xml' as menu %}

{% set sides = range(1, 14)|list %}
{% do sides.__setitem__(1, "2 PLYR") %}
{% call(choice) picker.PickerStateless("SwSide", "Switch Side", sides, 40, 690) %}
  <set_variable name="AI_Reassign_ChangeToSide" value="{{ 2 if choice == '2 PLYR' else choice }}.0" integer="yes" />
  <set_variable name="ReassignAI" value="1000.0" integer="yes" />
{% endcall %}

{% call(choice) picker.Picker("Dif", "Change", range(1, 11), "Difficulty", g.data.difficulty or 10, 40, 445) %}
  <set_difficulty_level value="{{ choice }}" />
{% endcall %}

  <folder_arme name="Comms Enable-Disable" id_arme="6e370a09-6c89-457e-b917-e7c866c6ad45" parent_id_arme="846725f1-9752-4065-a2a1-9f52b9a4a32b" />
  <event name="Enable Comms" id_arme="a074453c-bc65-4818-9f50-44c34f64b5eb" parent_id_arme="6e370a09-6c89-457e-b917-e7c866c6ad45">
    <if_gm_button text="Comm:OFF" />
    <clear_gm_button text="Comm:OFF" />
    <set_gm_button text="Comm:ON" x="140" y="510" h="28" w="90" />
    <set_variable name="AICommsControl" value="2.0" integer="yes" />
  </event>
  <event name="Disable Comms" id_arme="af117b8c-12c4-4d29-95a9-2f280e2af311" parent_id_arme="6e370a09-6c89-457e-b917-e7c866c6ad45">
    <if_gm_button text="Comm:ON" />
    <clear_gm_button text="Comm:ON" />
    <set_gm_button text="Comm:OFF" x="140" y="510" h="28" w="90" />
    <set_variable name="AICommsControl" value="1.0" integer="yes" />
  </event>
  <folder_arme name="Commands" id_arme="7ef9ad11-aebe-4397-aa87-16d7e5aa88a2" parent_id_arme="846725f1-9752-4065-a2a1-9f52b9a4a32b" />
  <event name="Move to GM" id_arme="f1922817-0270-487a-ba37-d68a96c9c11b" parent_id_arme="7ef9ad11-aebe-4397-aa87-16d7e5aa88a2">
    <if_gm_button text="Grp to GM" />
    <set_variable name="ReassignAI" value="1025.0" integer="yes" />
  </event>
  <event name="Delete Group" id_arme="69e6def2-cb83-43cd-9026-90a502cbe5b5" parent_id_arme="7ef9ad11-aebe-4397-aa87-16d7e5aa88a2">
    <if_gm_button text="Del Grp" />
    <set_variable name="ReassignAI" value="1999.0" integer="yes" />
  </event>
  <folder_arme name="Direction Controls" id_arme="db6a0663-4c0e-4b4c-9baf-e203cf72afaf" parent_id_arme="7ef9ad11-aebe-4397-aa87-16d7e5aa88a2" />
  <event name="STOP" id_arme="be3a5377-d770-48ad-9492-14aab538b014" parent_id_arme="db6a0663-4c0e-4b4c-9baf-e203cf72afaf">
    <if_gm_button text="STOP    O" />
    <set_variable name="ReassignAI" value="1030.0" integer="yes" />
  </event>

  <event name="EnableDirMoveAI">
      <if_gm_button text="Dir Move" />
      <set_variable name="DirectionalStrikeEnabled" value="0.0" integer="yes" />
  </event>
  <event name="EnableDirStrikeAI">
      <if_gm_button text="Dir Strike" />
      <set_variable name="DirectionalStrikeEnabled" value="1.0" integer="yes" />
  </event>
  {% for ai_code, props in {
    "1031.0": {
      "name": "move",
      "condition": "0.0",
    },
    "1032.0": {
      "name": "strike",
      "condition": "1.0",
    },
  }.items() %}
    {% for dir, text in {
      0: "0   /\\",
      45: "45   //",
      90: "90   >>",
      135: "135   \\\\",
      180: "180   V",
      225: "225   //",
      270: "270   <<",
      315: "315   \\\\",
    }.items() %}
    <event name="{{ dir }} degrees {{ props.name }}" id_arme="07509f0e-5c9b-4a08-97f9-169664290201" parent_id_arme="db6a0663-4c0e-4b4c-9baf-e203cf72afaf">
      <if_gm_button text="{{ text }}" />
      <if_variable name="DirectionalStrikeEnabled" comparator="EQUALS" value="{{ props.condition }}" />
      <set_variable name="AI_Reassign_ThrottleDir" value="{{ dir }}.0" integer="yes" />
      <set_variable name="ReassignAI" value="{{ ai_code }}" integer="yes" />
    </event>
    {% endfor %}
  {% endfor %}

  <event name="Increase Speed" id_arme="bfebddcb-b230-4c94-98bd-5717a686ecdc" parent_id_arme="db6a0663-4c0e-4b4c-9baf-e203cf72afaf">
    <if_gm_button text="Speed +0.6" />
    <set_variable name="ReassignAI" value="1040.0" integer="yes" />
  </event>
  <event name="Decrease Speed" id_arme="b463f0a4-edc2-483f-8fd5-8452706da009" parent_id_arme="db6a0663-4c0e-4b4c-9baf-e203cf72afaf">
    <if_gm_button text="Speed -0.6" />
    <set_variable name="ReassignAI" value="1041.0" integer="yes" />
  </event>
  <folder_arme name="Enemy Commands" id_arme="fbd2b394-7c69-4e27-b55e-6faaec28a8f9" parent_id_arme="7ef9ad11-aebe-4397-aa87-16d7e5aa88a2" />
  <event name="GrpToGM" id_arme="5ad2f952-0534-4a8b-b2ba-850bc1e61ac9" parent_id_arme="fbd2b394-7c69-4e27-b55e-6faaec28a8f9">
    <if_gm_button text="GrpToGM" />
    <set_variable name="ReassignAI" value="1025.0" integer="yes" />
  </event>
  {% call menu.onButtonClick("Unsurrender", menu.main.ai) %}
    <set_variable name="ReassignAI" value="1022.0" integer="yes" />
  {% endcall %}
  {% call menu.onButtonClick("Surrender", menu.main.ai) %}
    <set_variable name="ReassignAI" value="1021.0" integer="yes" />
  {% endcall %}
