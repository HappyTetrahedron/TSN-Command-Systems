  {% endcall %}
  {% call menu.onButtonClick("Noncombat", menu.main.ai) %}
    <set_variable name="ReassignAI" value="50.0" integer="yes" />
  {% endcall %}

  {{ menu.addDismissableSubmenu("Specials", menu.main.ai) }}


  {% for ability in util.abilities %}
    {% call menu.onMenuClick("Add\\" + ability.name, "Specials") %}
      <set_special use_gm_selection="" ship="{{ ability.id }}" />
    {% endcall %}
  {% endfor %}
  {% for special in util.specials %}
    {% call menu.onMenuClick("Add\\" + special, "Specials") %}
      <set_special use_gm_selection="" ability="{{ special }}" />
    {% endcall %}
    {% call menu.onMenuClick("Clear\\" + special, "Specials") %}
      <set_special use_gm_selection="" clear="yes" ability="{{ special }}" />
    {% endcall %}
  {% endfor %}
  {% call menu.onMenuClick("Clear\\Clear All", "Specials") %}
    {% for special in util.specials %}
      <set_special use_gm_selection="" clear="yes" ability="{{ special }}" />
    {% endfor %}
  {% endcall %}

