{% import 'Utils.xml' as util %}

  <event name="Restart Letter Cycle" id_arme="8e028e49-f46e-44b3-b585-c88fe25d4c62" parent_id_arme="2dd8bf7f-9203-4c1a-9bea-2a4d2d3c05a6">
    <if_not_exists name="--" />
    <if_variable name="LetterPrefix" comparator="GREATER_EQUAL" value="26.0" />
    <set_variable name="LetterPrefix" value="1.0" integer="yes" />
    <set_variable name="Name Assign" value="0.0" integer="yes" />
  </event>
  <event name="Complete Name Assign" id_arme="12d000ac-f7f4-417c-b3b3-622e162de342" parent_id_arme="2dd8bf7f-9203-4c1a-9bea-2a4d2d3c05a6">
    <if_variable name="Name Assign" comparator="GREATER_EQUAL" value="1.0" />
    <if_not_exists name="--" />
    <if_variable name="LetterPrefix" comparator="LESS" value="26.0" />
    <set_variable name="LetterPrefix" value="LetterPrefix+1" integer="yes" />
    <set_variable name="Name Assign" value="0.0" integer="yes" />
  </event>
  <event name="Begin Name Assign Cycle" id_arme="ceae3461-55fc-40f0-ad80-abddb00b3c86" parent_id_arme="2dd8bf7f-9203-4c1a-9bea-2a4d2d3c05a6">
    <if_variable name="Name Assign" comparator="EQUALS" value="1.0" />
    <set_variable name="firstnumber" randomIntLow="0" randomIntHigh="9" />
    <set_variable name="secondnumber" randomIntLow="0" randomIntHigh="9" />
    <set_variable name="LetterPrefix" value="LetterPrefix" integer="yes" />
    <set_variable name="Name Assign" value="2.0" integer="yes" />
  </event>

{% for letter in util.FleetLetters %}
  <event name="{{ letter }}-- Already Exists">
    <if_variable name="Name Assign" comparator="EQUALS" value="2.0" />
    <if_variable name="LetterPrefix" comparator="EQUALS" value="{{ loop.index }}.0" />
    <if_exists name="{{ letter }}|firstnumber||secondnumber|" />
    <set_variable name="Name Assign" value="1.0" integer="yes" />
  </event>
  <event name="{{ letter }}">
    <if_variable name="Name Assign" comparator="EQUALS" value="2.0" />
    <if_variable name="LetterPrefix" comparator="EQUALS" value="{{ loop.index }}.0" />
    <if_exists name="--" />
    <if_not_exists name="{{ letter }}|firstnumber||secondnumber|" />
    <set_ship_text name="--" newname="{{ letter }}|firstnumber||secondnumber|" />
    <set_variable name="Name Assign" value="1.0" integer="yes" />
  </event>
{% endfor %}